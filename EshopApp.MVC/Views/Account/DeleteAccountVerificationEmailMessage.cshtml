@{
    ViewData["Title"] = "Delete Account Verification Page";
}

<div class="d-flex justify-content-center align-items-center pt-3 pt-md-5">

    <div class="text-center px-4 border p-4 rounded-4 shadow bg-white" style="transform: translateY(-3vh); max-width: 700px;">

        <div class="mb-4">
            <img src="~/Images/emailSentSuccessfully.png"
                 alt="Email Successfully Sent"
                 class="img-fluid rounded-4"
                 style="max-height: 400px; object-fit: cover;" />
        </div>

        <h1 class="fw-bold mb-3 mt-0 pt-0">Ο Λογαριασμός Σας Διαγράφηκε Επιτυχώς</h1>

        <p class="text-muted mb-4">
            Λυπόμαστε που φεύγετε!<br>
            Ένα email έχει σταλεί στον λογαριασμό σας, το οποίο θα επιβεβαιώνει τη διαγραφή του λογαριασμού σας.<br>
            Αν έχετε οποιοδήποτε πρόβλημα ή ερώτηση μπορείτε να επικοινωνήσετε μαζί μας μέσω του email υποστήριξης kinnaskonstantinos0@gmail.com.<br>
        </p>

        <div class="d-grid gap-2">

            <a asp-controller="Home" asp-action="Index" class="btn fw-semibold text-white" style="background:var(--accent-orange); border:none;">Επιστροφή στην αρχική</a>
            <a asp-controller="Home" asp-action="ViewItems" class="btn btn-outline-secondary border">Συνέχεια αγορών</a>
        </div>
    </div>

</div>