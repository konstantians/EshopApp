@{
    ViewData["Title"] = "Register Verification Page";
}

<script>
    if (!localStorage.getItem('showVerificationPage')) {
        localStorage.setItem('showVerificationPage', 'true');
    } else {
        window.location.href = '/Home/Index';
    }

    window.addEventListener('beforeunload', function () {
        localStorage.removeItem('showVerificationPage');
    });

    const POLL_INTERVAL_MS = 5000;
    async function checkIfAuthenticated() {
        try {
            const response = await fetch('/Account/BasicFrontEndAccessTokenValidation', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const data = await response.json();
            if (data === true) {
                window.location.href = '/Home/Index';
            }
        } catch (error) {
            console.error('Polling error:', error);
        }
    }

    setInterval(checkIfAuthenticated, POLL_INTERVAL_MS);
</script>

<div class="d-flex justify-content-center align-items-center pt-3 pt-md-5">

    <div class="text-center px-4 border p-4 rounded-4 shadow bg-white" style="transform: translateY(-3vh); max-width: 700px;">

        <div class="mb-4">
            <img src="~/Images/emailSentSuccessfully.png"
                 alt="Email Successfully Sent"
                 class="img-fluid rounded-4"
                 style="max-height: 400px; object-fit: cover;" />
        </div>

        <h1 class="fw-bold mb-3 mt-0 pt-0">Επιβεβαίωση Εγγραφής!</h1>

        <p class="text-muted mb-4">
            Σας ευχαριστούμε που δημιουργήσατε λογαριασμό μαζί μας!<br>
            Για την ενεργοποίηση του λογαριασμού σας θα πρέπει να ελέγξετε τα εισερχόμενα του email σας και να επιβεβαιώσετε την εγγραφή σας κάνοντας κλικ στον σύνδεσμο επιβεβαίωσης που σας έχουμε αποστείλει.
        </p>

        <div class="d-grid gap-2">

            <a asp-controller="Home" asp-action="Index" class="btn fw-semibold text-white" style="background:var(--accent-orange); border:none;">Επιστροφή στην αρχική</a>
            <a asp-controller="Home" asp-action="ViewItems" class="btn btn-outline-secondary border">Συνέχεια αγορών</a>
        </div>

        <div class="mt-4 small text-muted">
            Σημείωση: Προσπάθεια σύνδεσης στον λογαριασμό σας πριν από την ενεργοποίηση θα αποτύχει
        </div>

    </div>

</div>