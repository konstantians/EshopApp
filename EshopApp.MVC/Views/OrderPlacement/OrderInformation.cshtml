@model OrderInformationViewModel

@{
    ViewData["Title"] = "Order Information";
    bool canPlaceOrder = true;
}

<style>
    .border-warning{
        border-color: var(--accent-orange) !important;
    }

    .hoverable-background {
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

        .hoverable-background:hover {
            background-color: #e3e3e3;
        }

    .card-stock-issue {
        border: 1.5px solid var(--accent-orange) !important;
    }

    .stock-notice {
        margin-top: 14px;
        padding: 10px 14px;
        border: solid 1px #dddddd;
        background: rgba(255,94,0,.08) !important;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        @@media (max-width: 575.99px) {
            .stock-notice {
                align-items: flex-start;
            }
        }

        .stock-notice .stock-icon {
            width: 26px;
            height: 26px;
            min-width: 26px;
            border-radius: 50%;
            background-color: var(--accent-orange);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
        }

    .stock-content {
        flex: 1;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px 12px;
        color: #444;
    }

        .stock-content strong {
            color: #000;
        }

        .stock-content span {
            white-space: nowrap;
        }

    .stock-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .stock-btn {
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 3px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        line-height: 1.2;
        white-space: nowrap;
    }

    .stock-btn-update {
        background-color: var(--accent-orange);
        color: #fff;
    }

        .stock-btn-update:hover {
            color: #ffffff;
            background-color: #e25400;
        }

    .stock-btn-remove {
        background-color: #fff;
        color: #555;
        border-color: #ddd;
    }

        .stock-btn-remove:hover {
            background-color: #f7f7f7;
            border-color: #bbb;
            color: #000;
        }

    .text-mobile {
        display: none;
    }

    .hide-icon-on-small{
        display:inline;
    }

    @@media (max-width: 390px){
        .hide-icon-on-small{
            display: none;
        }
    }

    @@media (max-width: 576px) {
        .text-full
        {
            display: none;
        }

        .text-mobile {
            display: inline;
        }
    }

    .disabled-look {
        pointer-events: auto !important;
        cursor: not-allowed !important;
        opacity: 0.7;
    }
</style>

<script>
    const cart = JSON.parse(localStorage.getItem("cart"));
    const orderData = JSON.parse(localStorage.getItem("orderData"));
    const orderAddress = orderData?.orderAddress;

    if (!cart?.cartItems?.length) {
        window.location.href = '@Url.Action("ViewCart", "Home")';
    }
    else if (!orderData?.orderAddress
        || !orderAddress.email || !orderAddress.firstName || !orderAddress.lastName
        || !orderAddress.country || !orderAddress.city || !orderAddress.postalCode || !orderAddress.address) {
        window.location.href = '@Url.Action("CustomerInformation", "OrderPlacement")';
    }
    else if (orderAddress.isShippingAddressDifferent && (
        !orderAddress.altEmail || !orderAddress.altFirstName || !orderAddress.altLastName
        || !orderAddress.altCountry || !orderAddress.altCity || !orderAddress.altPostalCode || !orderAddress.altAddress)) {
        window.location.href = '@Url.Action("CustomerInformation", "OrderPlacement")';
    }
</script>

<link rel="stylesheet" href="~/css/timelineStyles.css" />

<div class="mt-5">
    <div class="d-flex justify-content-between timeline-step mx-auto px-4">
        <a asp-controller="Home" asp-action="ViewCart" class="dot step-1 active text-extra-smallest text-sm-smaller"></a>
        <div class="line active"></div>
        <a asp-controller="OrderPlacement" asp-action="CustomerAccountTypeSelection" class="dot step-2 active text-extra-smallest text-sm-smaller"></a>
        <div class="line active"></div>
        <a asp-controller="OrderPlacement" asp-action="CustomerInformation" class="dot step-3 active text-extra-smallest text-sm-smaller"></a>
        <div class="line active"></div>
        <a asp-controller="OrderPlacement" asp-action="OrderInformation" class="dot step-4 active text-extra-smallest text-sm-smaller"></a>
        <div class="line"></div>
        <div class="dot step-5 text-extra-smallest text-sm-smaller"></div>
    </div>
</div>

<div class="mt-5 pt-4" id="outsideContainer">
    <div class="row mb-3" style="margin-left:0 !important;margin-right:0 !important;">
        <div class="position-relative col-12 col-lg-6 col-xl-7 pe-lg-2 p-0" style="min-height:175px;">
            <form id="orderInformationForm" method="post">
                <div id="customerAddressSection" class="mb-3">
                    <h5 class="mb-2">Διευθυνση Αποστολής</h5>
                    <div class="d-flex flex-column" style="line-height:1.1;">
                        <span class="text-secondary" id="fullNameSpan"></span>
                        <span class="text-secondary" id="fullAddressSpan"></span>
                        <span class="text-secondary" id="citySpan"></span>
                        <span class="text-secondary" id="countrySpan"></span>
                        <span class="text-secondary" id="phoneNumber"></span>
                        <a asp-controller="OrderPlacement" asp-action="CustomerInformation" class="text-info hover-primary mt-2 text-bigger" style="text-decoration:none;">Επεξεργασία</a>
                    </div>
                </div>
                <script>
                    if(!orderAddress.isShippingAddressDifferent){
                        document.getElementById("fullNameSpan").textContent = orderAddress.firstName + " " + orderAddress.lastName;
                        document.getElementById("fullAddressSpan").textContent = orderAddress.address + " " + orderAddress.postalCode;
                        document.getElementById("citySpan").textContent = orderAddress.city;
                        document.getElementById("countrySpan").textContent = orderAddress.country;
                        if(orderAddress.phoneNumber){
                            document.getElementById("phoneNumber").textContent = orderAddress.phoneNumber;
                        }
                        else{
                            document.getElementById("phoneNumber").classList.add("d-none");
                        }
                    }
                    else{
                        document.getElementById("fullNameSpan").textContent = orderAddress.altFirstName + " " + orderAddress.altLastName;
                        document.getElementById("fullAddressSpan").textContent = orderAddress.altAddress + " " + orderAddress.altPostalCode;
                        document.getElementById("citySpan").textContent = orderAddress.altCity;
                        document.getElementById("countrySpan").textContent = orderAddress.altCountry;
                        if(orderAddress.altPhoneNumber){
                            document.getElementById("phoneNumber").textContent = orderAddress.altPhoneNumber;
                        }
                        else{
                            document.getElementById("phoneNumber").classList.add("d-none");
                        }
                    }
                </script>
                <div id="shippingOptionSection" class="mb-3">
                    <h5 class="mb-2">Τρόπος Αποστολής</h5>
                    <div class="border">
                        @for (int i = 0; i < Model.UiShippingOptions.Count; i++)
                        {
                            UiShippingOption shippingOption = Model.UiShippingOptions[i];

                            <label class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center p-2 p-lg-3 border hoverable-background" id="shippingOptionLabel-@shippingOption.Id">
                                <div class="d-flex align-items-start gap-2">

                                    <input class="form-check-input m-0 mt-1 flex-shrink-0" data-extra-cost="@shippingOption.ExtraCost" style="cursor:pointer;" type="radio" name="shipping" checked="@(i == 0)" id="shippingOptionInput-@shippingOption.Id">

                                    <div>
                                        <div>@shippingOption.Name</div>
                                        <div class="text-muted text-smaller lh-1">@shippingOption.Description</div>
                                    </div>

                                </div>

                                @if (shippingOption.ExtraCost == 0)
                                {
                                    <span class="fw-semibold ms-4">Δωρεάν</span>
                                }
                                else
                                {
                                    <span class="fw-semibold" style="margin-left:27px;">@shippingOption.ExtraCost €</span>
                                }
                            </label>
                        }
                    </div>
                </div>
                <div id="paymentOptionSection" class="mb-3">
                    <h5 class="mb-2">Τρόπος Πληρωμής</h5>
                    <div class="border">
                        @for (int i = 0; i < Model.UiPaymentOptions.Count; i++)
                        {
                            UiPaymentOption paymentOption = Model.UiPaymentOptions[i];
                            string hidePaymentOption = paymentOption.Id == "payment_cod" && Model.UiShippingOptions.Count > 0 && Model.UiShippingOptions[0].Id == "ship_pickup" ? "d-none" : "";

                            <label class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center p-2 p-lg-3 border hoverable-background @hidePaymentOption" id="paymentOptionLabel-@paymentOption.Id">
                                <div class="d-flex align-items-start gap-2">

                                    <input class="form-check-input m-0 mt-1 flex-shrink-0" style="cursor:pointer;" type="radio" name="paymentOption" data-payment-option-name-alias="@paymentOption.NameAlias" 
                                        data-extra-cost="@paymentOption.ExtraCost" id="paymentOptionInput-@paymentOption.Id" checked="@(i == 0)">

                                    <div>
                                        <div>@paymentOption.Name</div>
                                        <div class="text-muted text-smaller lh-1">@paymentOption.Description</div>
                                    </div>

                                </div>

                                @if (paymentOption.ExtraCost == 0)
                                {
                                    <span class="fw-semibold ms-4">Δωρεάν</span>
                                }
                                else
                                {
                                    <span class="fw-semibold" style="margin-left:27px;">@paymentOption.ExtraCost €</span>
                                }
                            </label>
                        }
                    </div>
                </div>
                <div id="finalNotesSection" class="mb-3">
                    <h5 class="mb-2">Σχόλια</h5>
                    <textarea id="commentTextArea" class="form-control" rows="4" placeholder="Γράψτε εδώ..."></textarea>
                </div>

                <label class="form-check d-flex align-items-center px-3 py-2 gap-2 w-100 hoverable-background">
                    <input class="form-check-input m-0" type="checkbox" id="termsCheckbox" required>
                    <span class="form-check-label">Συμφωνώ με τους <a href="https://policies.google.com/terms" target="_blank" class="text-info text-decoration-none fst-italic">Όρους χρήσης</a> *</span>
                </label>
            </form>
            <div id="formLoadingOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center d-none" style="z-index: 10;">
                <div class="text-center">
                    <div class="spinner-border text-info" role="status" style="width:85px; height:85px;"></div>
                    <div class="mt-3 text-muted">Επεξεργασία Παραγγελίας...</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6 col-xl-5 p-lg-2 p-0">
            <div class="card" id="productsContainer">
                <div id="summaryLoadingOverlay"
                     class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center d-none" style="background: rgba(255,255,255,0.7); z-index: 10;">
                    <div class="text-center">
                        <div class="spinner-border text-info" role="status" style="width:70px; height:70px;"></div>
                        <div class="mt-3 text-muted">Επεξεργασία αλλαγών...</div>
                    </div>
                </div>
                <div class="card-body">
                    <h5 class="fw-semibold mb-3">Σύνοψη Παραγγελίας</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">Τιμή Άνα Προϊόν</span>
                    </div>

                    @{
                        decimal? finalPrice = 0;
                    }
                    @if (Model.User is not null)
                    {
                        @foreach (UiCartItem cartItem in Model.User.Cart!.CartItems)
                        {
                            var imageFile = cartItem.Variant!.VariantImages.FirstOrDefault()?.Image?.ImagePath;
                            string imagePath = Url.Content(string.IsNullOrEmpty(imageFile) ? "~/Images/noProductImage.jpg" : $"~/DynamicImages/{imageFile}");

                            decimal? cartItemFullPrice = @cartItem.Quantity * @cartItem.Variant!.Price;
                            @if (cartItem.Variant.Discount is not null)
                            {
                                cartItemFullPrice = cartItem.Quantity * (cartItem.Variant!.Price - (cartItem.Variant!.Price * cartItem.Variant.Discount.Percentage / 100));
                            }

                            bool hasStockIssue = cartItem.Variant.UnitsInStock < cartItem.Quantity;
                            if (hasStockIssue)
                            {
                                canPlaceOrder = false;
                            }

                            <div class="card mb-2 @(hasStockIssue ? "border-warning" : "")" id="cardId_@cartItem.Id" 
                                data-quantity="@cartItem.Variant.UnitsInStock" data-initial-quantity="@cartItem.Quantity" data-price="@cartItem.Variant.Price">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="d-flex align-items-vertical me-3">
                                                <a asp-controller="Home" asp-action="ViewItem" asp-route-id="@cartItem.Variant!.Product!.Id" class="me-3">
                                                    <div class="position-relative d-inline-block">
                                                        <img src="@imagePath" height="80" width="80">
                                                        <span class="position-absolute top-0 start-100 translate-middle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                              style="width:20px;height:20px;font-size:12.5px;padding-bottom:3px;" id="cartItemQuantityBadge-@cartItem.Id">
                                                            @cartItem.Quantity
                                                        </span>
                                                    </div>
                                                </a>

                                                <div>
                                                    <a asp-controller="Home" asp-action="ViewItem"
                                                       asp-route-id="@cartItem.Variant!.Product!.Id"
                                                       class="fw-medium text-dark text-decoration-none d-block hover-primary">
                                                        @cartItem.Variant!.Product!.Name
                                                    </a>

                                                    <small class="text-muted">
                                                        SKU: @cartItem.Variant!.SKU
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="fw-medium mb-1" id="cartItemFullPriceForItem-@cartItem.Id">
                                                @cartItemFullPrice &#8364;
                                            </div>
                                        </div>
                                    </div>

                                    @if (hasStockIssue)
                                    {
                                        <div class="stock-notice" id="stockWarning-@cartItem.Id">
                                            <div class="stock-icon">
                                                <i class="fa-solid fa-triangle-exclamation"></i>
                                            </div>
                                            <div class="stock-content">
                                                @if(cartItem.Variant.UnitsInStock != 0)
                                                {
                                                    <span>Διαθέσιμα μόνο <strong>@cartItem.Variant.UnitsInStock</strong> τεμ.</span>
                                                }
                                                else
                                                {
                                                    <span>Το προϊόν έχει εξαντληθεί</span>
                                                }
                                                <div class="stock-actions">
                                                    @if (cartItem.Variant.UnitsInStock != 0)
                                                    {
                                                        <a class="stock-btn stock-btn-update" id="updateCartItemButton_@cartItem.Id" data-available-stock="@cartItem.Variant.UnitsInStock"
                                                           onclick="updateCartItemAndUpdateUI('@cartItem.Id', 'cardId_@cartItem.Id')">

                                                            <i class="fa-solid fa-arrows-rotate me-1 hide-icon-on-small"></i>

                                                            <span class="text-full">Ενημέρωση σε @cartItem.Variant.UnitsInStock</span>
                                                            <span class="text-mobile">Ενημέρωση</span>
                                                        </a>
                                                    }
                                                    <a class="stock-btn stock-btn-remove" id="removeCartItemButton_@cartItem.Id" onclick="removeFromCartAndUpdateUI('@cartItem.Id', 'cardId_@cartItem.Id')">
                                                        <i class="fa-solid fa-trash me-1 hide-icon-on-small"></i>Αφαίρεση
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            finalPrice += cartItemFullPrice;
                        }
                    }

                    <hr id="finalPriceSeparator">

                    <div class="d-flex flex-column between fw-semibold mb-2" id="finalPriceContainer">
                        <div id="subtotalSubsection" class="d-flex justify-content-between align-items-center">
                            <span class="text-smaller text-secondary">ΥΠΟΣΥΝΟΛΟ:</span>
                            <span class="text-biggest text-info" data-subtotal-price="@finalPrice" id="subtotalSpan">@finalPrice &#8364;</span>
                        </div>
                        <div id="deliveryCostSubsection" class="d-none d-flex justify-content-between align-items-center">
                            <span class="text-smaller text-secondary">ΈΞΟΔΑ ΑΠΟΣΤΟΛΗΣ:</span>
                            <span class="text-biggest text-info" data-delivery-cost="0" id="deliveryCostSpan">0.00 &#8364;</span>
                        </div>
                        <div id="cashOnDeliveryCostSubsection" class="d-none d-flex justify-content-between align-items-center">
                            <span class="text-smaller text-secondary">ΈΞΟΔΑ ΑΝΤΙΚΑΤΑΒΟΛΗΣ:</span>
                            <span class="text-biggest text-info" data-payment-option-cost="0" id="cashOnDeliveryCostSpan">@finalPrice &#8364;</span>
                        </div>
                        <div id="finalPriceSubSection" class="d-flex justify-content-between align-items-center">
                            <span class="text-smaller text-secondary">ΣΥΝΟΛΟ ΠΑΡΑΓΓΕΛΙΑΣ:</span>
                            <span class="text-biggest text-info" data-final-Price="@finalPrice" id="finalPriceSpan">@finalPrice &#8364;</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row" id="buttonsSection">
        <div class="col-12 col-lg-6 col-xl-7">
            <div class="row">
                <div class="col-6 col-xl-4">
                    <a asp-action="CustomerInformation" asp-controller="OrderPlacement" class="btn btn-outline-dark py-3 px-4 border border-1 w-100"><i class="fa-solid fa-chevron-left me-2"></i>Επιστροφή</a>
                </div>
                <div class="col-6 col-xl-4 offset-xl-4">
                    <button id="orderConfirmButton"
                            type="submit" class="btn btn-primary py-3 px-4 w-100 @(canPlaceOrder ? "" : "disabled-look")" title="Διόρθωστε όλα τα προβλήματα στο καλάθι για να συνεχίσετε στο checkout"
                            onclick="if(!this.dataset.enabled) return false; document.getElementById('orderInformationForm').requestSubmit();"
                            data-enabled="@(canPlaceOrder.ToString().ToLower())">
                        Ολοκλήρωση <i class="fa-solid fa-chevron-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade custom-center-modal modal-result" data-bs-backdrop="static" id="resultModal" data-testid="resultModal" data-popUpValue="" tabindex="-1">
    <div class="modal-dialog modal-confirm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <div class="icon-box">
                    <i class="fas fa-check"></i>
                </div>
                <h4 class="modal-title w-100" id="myModalLabel"></h4>
            </div>
            <div class="modal-body">
                <p class="text-center"></p>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button class="btn btn-primary w-75" data-bs-dismiss="modal" data-testid="resultModalCloseButton">Εντάξει</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/js/customModals.js"></script>
<script src="~/js/cartFunctionality.js"></script>

<script>
    let subtotalSpan = document.getElementById("subtotalSpan");
    let deliveryCostSpan = document.getElementById("deliveryCostSpan");
    let paymentOptionCostSpan = document.getElementById("cashOnDeliveryCostSpan");
    let finalPriceSpan = document.getElementById("finalPriceSpan");
    let finalPrice = Number(finalPriceSpan.dataset.finalPrice) || 0;

    function getLocalCart() {
        try {
            return JSON.parse(localStorage.getItem("cart")) || null;
        } catch (e) {
            console.error("Invalid cart in localStorage", e);
            return null;
        }
    }

    async function buildCartFromLocalStorage() {
        document.getElementById("summaryLoadingOverlay").classList.remove('d-none');
        document.getElementById("buttonsSection").classList.add('d-none');

        const cart = getLocalCart();
        let cartItemValidationModels = cart.cartItems.map(item => ({
            quantity: item.quantity,
            cartItemId: item.id,
            sku: item.variant.sku
        }))

        const res = await fetch("/OrderPlacement/ValidateAllCartItems", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(cartItemValidationModels)
        });

        if (!res.ok) {
            if (res.status === 503) {
                window.location.href = "/Error/Error503";
                return;
            }
            if (res.status >= 500) {
                window.location.href = "/Error/Error500";
                return;
            }
        }

        const data = await res.json();
        const validationMap = new Map(
            data.validatedVariants.map(v => [v.cartItemId, v])
        );


        cart.cartItems.forEach(item => {
            const validation = validationMap.get(item.id);

            const cartItemFullPrice = item.quantity * item.variant.price;
            let imagePath = window.appConfig.noProductImageUrl;
            if(item.variant.variantImages?.[0]?.image?.imagePath){
                imagePath = window.appConfig.dynamicImagesUrl + item.variant.variantImages?.[0]?.image?.imagePath;
            }

            let warningHtml = ""
            if(validation.unitsInStockAtCurrentMoment < item.quantity){
                warningHtml = stockWarningHtml(item.id, validation.unitsInStockAtCurrentMoment);
            }

            const summaryHtml = `
                <div class="card mb-2" id="cardId_${item.id}" data-quantity="${validation.unitsInStockAtCurrentMoment}" data-price="${item.variant.price}" data-initial-quantity="${item.quantity}">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-8">
                                <div class="d-flex align-items-vertical me-3">
                                    <a href="/Home/ViewItem/${item.variant.product.id}" class="me-3">
                                        <div class="position-relative d-inline-block">
                                            <img src="${imagePath}" height="80" width="80">
                                            <span class="position-absolute top-0 start-100 translate-middle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                    style="width:20px;height:20px;font-size:12.5px;padding-bottom:3px;" id="cartItemQuantityBadge-${item.Id}">
                                                ${item.quantity}
                                            </span>
                                        </div>
                                    </a>
                                    <div>
                                        <a href="/Home/ViewItem/${item.variant.product.id}" class="fw-medium text-dark text-decoration-none d-block hover-primary">
                                            ${item.variant.product.name}
                                        </a>

                                        <small class="text-muted">
                                            SKU: ${item.variant.sku}
                                        </small>
                                    </div>

                                </div>
                            </div>

                            <div class="col-4 text-end">
                                <div class="fw-medium mb-1" id="cartItemFullPriceForItem-${item.id}">
                                    ${cartItemFullPrice.toFixed(2)} €
                                </div>
                            </div>
                        </div>
                        ${warningHtml}
                    </div>
                </div>
            `;
            
            finalPrice += cartItemFullPrice;
            document.getElementById("finalPriceSeparator").insertAdjacentHTML("beforebegin", summaryHtml);
        });

        // updateFinal price
        subtotalSpan.textContent = finalPrice.toFixed(2) + " €";
        subtotalSpan.dataset.subtotalPrice = finalPrice.toFixed(2);
        finalPriceSpan.textContent = finalPrice.toFixed(2) + " €";
        finalPriceSpan.dataset.finalPrice = finalPrice;

        document.getElementById("summaryLoadingOverlay").classList.add('d-none');
        document.getElementById("buttonsSection").classList.remove('d-none');
    }

    // only do this when the Model is null
    @if (Model.User is null)
    {
        <text>
            document.addEventListener("DOMContentLoaded", buildCartFromLocalStorage);
        </text>
    }

    document.getElementById("orderInformationForm").addEventListener("submit", async function (e) {
        document.getElementById("outsideContainer").classList.remove('pt-4');
        document.getElementById("orderInformationForm").classList.add('d-none');
        document.getElementById("formLoadingOverlay").classList.remove('d-none');
        document.getElementById("buttonsSection").classList.add('d-none');

        const successUrl = '@Url.Action("OrderSuccess", "OrderPlacement", null, Context.Request.Scheme)';
        const cancelUrl = '@Url.Action("OrderFailure", "OrderPlacement", null, Context.Request.Scheme)';

        const cart = JSON.parse(localStorage.getItem("cart"));
        const orderAddress = JSON.parse(localStorage.getItem("orderData"))?.orderAddress;

        const createCheckoutViewModel = {
            successUrl: successUrl,
            cancelUrl: cancelUrl,

            gatewayCreateOrderRequestModel: {
                comment: document.getElementById("commentTextArea").value,

                email: orderAddress.email,
                firstName: orderAddress.firstName,
                lastName: orderAddress.lastName,
                country: orderAddress.country,
                city: orderAddress.city,
                postalCode: orderAddress.postalCode,
                address: orderAddress.address,
                phoneNumber: orderAddress.phoneNumber,

                isShippingAddressDifferent: orderAddress.isShippingAddressDifferent ?? false,

                altFirstName: orderAddress.altFirstName ?? null,
                altLastName: orderAddress.altLastName ?? null,
                altCountry: orderAddress.altCountry ?? null,
                altCity: orderAddress.altCity ?? null,
                altPostalCode: orderAddress.altPostalCode ?? null,
                altAddress: orderAddress.altAddress ?? null,
                altPhoneNumber: orderAddress.altPhoneNumber ?? null,

                userId: cart.userId ?? null,

                shippingOptionId: document.querySelector('input[name="shipping"]:checked')?.id.split('-')[1],
                paymentOptionId: document.querySelector('input[name="paymentOption"]:checked')?.id.split('-')[1],
                userCouponId: null, //leave that null for now

                orderItemRequestModels: cart.cartItems.map(item => ({
                    quantity: item.quantity,
                    variantId: item.variant.id
                }))
            }
        };

        e.preventDefault();

        try {
            let response = null;

            if (document.querySelector('input[name="paymentOption"]:checked').dataset.paymentOptionNameAlias === "cod"){
                response = await fetch("/OrderPlacement/PlaceOrderWithoutCheckOutSession", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(createCheckoutViewModel.gatewayCreateOrderRequestModel)
                });
            }
            else{
                response = await fetch("/OrderPlacement/CreateCheckOutSession", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(createCheckoutViewModel)
                });
            }

            //now it is 204, but maybe change to 201 in the future, 200 is for CreateCheckoutSession
            if (response.status === 200 || response.status === 201 || response.status === 204) {
                orderData.canProceedToConfirmation = true;
                localStorage.setItem("orderData", JSON.stringify(orderData));

                if(document.querySelector('input[name="paymentOption"]:checked').dataset.paymentOptionNameAlias === "cod"){
                    window.location.href = successUrl;
                }
                else{
                    const data = await response.json();
                    window.location.href = data.checkOutSessionUrl;
                }
                return;
            }
            else if(response.status === 503){
                window.location.href = "/Error/Error503";
                return;
            }
            else if(response.status > 500){
                window.location.href = "/Error/Error500";
                return;
            }

            document.getElementById("outsideContainer").classList.add('pt-4');
            document.getElementById("orderInformationForm").classList.remove('d-none');
            document.getElementById("formLoadingOverlay").classList.add('d-none');
            document.getElementById("buttonsSection").classList.remove('d-none');

            const error = await response.json().catch(() => null);
            const message = error?.errorMessage || "Παρουσιάστηκε πρόβλημα με την παραγγελία.";
            resultModal.setAttribute("popUpValue", message);

            if(message === "InvalidPaymentOption"){
                showPopUpModal('resultModal', "Λανθασμένος Τρόπος Πληρωμής", "Ο τρόπος πληρωμής που επιλέξατε δεν υπάρχει στο σύστημα. Παρακαλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.",
                    "Αποτυχία",  "Ο τρόπος πληρωμής που επιλέξατε δεν υπάρχει στο σύστημα. Παρακαλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.");

                document.getElementById("orderConfirmButton").classList.add('disabled-look');
                document.getElementById("orderConfirmButton").dataset.enabled = false;
            }
            else if(message === "InvalidShippingOption"){
                showPopUpModal('resultModal', "Λανθασμένος Τρόπος Αποστολής", "Ο τρόπος αποστολής που επιλέξατε δεν υπάρχει στο σύστημα. Παρακαλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.",
                    "Αποτυχία",  "Ο τρόπος αποστολής που επιλέξατε δεν υπάρχει στο σύστημα. Παρακαλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.");

                document.getElementById("orderConfirmButton").classList.add('disabled-look');
                document.getElementById("orderConfirmButton").dataset.enabled = false;
            }
            else if(message === "InvalidCouponIdWasGiven" || message === "CouponCodeCurrentlyDeactivated"){
                showPopUpModal('resultModal', "Λανθασμένο Κουπόνι", "Το κουπόνι που επιλέξατε είτε δεν υπάρχει στο σύστημα είτε δεν είναι συνδεδεμένο με τον λογαριασμό σας είτε είναι απενεργοποιημένο. " + 
                "Παρακαλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.",
                "Αποτυχία",  "Το κουπόνι που επιλέξατε είτε δεν υπάρχει στο σύστημα είτε δεν είναι συνδεδεμένο με τον λογαριασμό σας. Παρακαλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.");

                document.getElementById("orderConfirmButton").classList.add('disabled-look');
                document.getElementById("orderConfirmButton").dataset.enabled = false;
            }
            else if(message === "CouponUsageLimitExceeded"){
                showPopUpModal('resultModal', "Λανθασμένο Κουπόνι", "Έχετε φτάσει το όριο χρήσης του συγκεκριμένου κουπονιού. Παρακαλούμε αφαιρέστε το κουπόνι ή δοκιμαστε άλλο κουπόνι.",
                "Αποτυχία",  "Έχετε φτάσει το όριο χρήσης του συγκεκριμένου κουπονιού. Παρακαλούμε αφαιρέστε το κουπόνι ή δοκιμαστε άλλο κουπόνι");

                document.getElementById("orderConfirmButton").classList.add('disabled-look');
                document.getElementById("orderConfirmButton").dataset.enabled = false;
            }
            else if(message === "InvalidVariantIdWasGiven"){
                //Here tell the user to remove the item? Refresh wont change that
            }
            else if(message === "InsufficientStockForVariant"){
                let cartItemValidationModels = cart.cartItems.map(item => ({
                    quantity: item.quantity,
                    cartItemId: item.id,
                    sku: item.variant.sku
                }))

                try {
                    const res = await fetch("/OrderPlacement/ValidateAllCartItems", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(cartItemValidationModels)
                    });

                    if (!res.ok) {
                        if (res.status === 503) {
                            window.location.href = "/Error/Error503";
                            return;
                        }
                        if (res.status >= 500) {
                            window.location.href = "/Error/Error500";
                            return;
                        }
                    }

                    const data = await res.json();
                    data.validatedVariants.forEach(item => {
                        if (item.unitsInStockAtCurrentMoment >= item.quantity) {
                            return;
                        }

                        let foundCartItemInSection = document.getElementById("cardId_" + item.cartItemId);
                        if(!foundCartItemInSection){
                            return;
                        }

                        document.getElementById("cardId_" + item.cartItemId).classList.add('border-warning');
                        document.getElementById("cardId_" + item.cartItemId).dataset.quantity = item.unitsInStockAtCurrentMoment;
                        foundCartItemInSection.firstElementChild.insertAdjacentHTML("beforeend", stockWarningHtml(item.cartItemId, item.unitsInStockAtCurrentMoment));

                        document.getElementById("orderConfirmButton").classList.add('disabled-look');
                        document.getElementById("orderConfirmButton").dataset.enabled = false;
                    });
                } catch (err) {
                    console.error("Error validating cart:", err);
                }
            }
            else{
                resultModal.setAttribute("popUpValue", "unknownError");
                showPopUpModal('resultModal', "Αποτυχία Υποβολής Παραγγελίας", "Υπήρξε απρόβλεπτο πρόβλημα με τον server. Παρακαλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.",
                    "Αποτυχία", "Υπήρξε απρόβλεπτο πρόβλημα με τον server. Παρακλώ ανανεώστε την σελίδα και δοκιμάστε ξανά.");
            }

            return;

        } catch (err) {
            console.error(err);
            alert("Σφάλμα δικτύου. Δοκιμάστε ξανά.");
            return;
        }
    });

    document.querySelectorAll('input[name="shipping"]').forEach(input => {
        input.addEventListener('change', () => {
            if (input.checked) {
                //check for option that disables cod
                if(input.id === "shippingOptionInput-ship_pickup" && document.getElementById("paymentOptionInput-payment_cod")?.checked){
                    let firstPaymentOptionInput = document.querySelector('input[name="paymentOption"]:not(#paymentOptionInput-payment_cod)');
                    if(firstPaymentOptionInput){
                        firstPaymentOptionInput.checked = true;
                        paymentOptionCostSpan.dataset.paymentOptionCost = Number(firstPaymentOptionInput.dataset.extraCost);
                    }
                    document.getElementById("paymentOptionInput-payment_cod").checked = false;
                    document.getElementById("cashOnDeliveryCostSubsection").classList.add("d-none");
                };

                finalPrice = Number(input.dataset.extraCost) + Number(subtotalSpan.dataset.subtotalPrice) + Number(paymentOptionCostSpan.dataset.paymentOptionCost);

                if(input.dataset.extraCost > 0){
                    document.getElementById("deliveryCostSubsection").classList.remove("d-none");
                    deliveryCostSpan.dataset.deliveryCost = Number(input.dataset.extraCost);
                    deliveryCostSpan.textContent = Number(input.dataset.extraCost).toFixed(2) + " €";
                    document.getElementById("paymentOptionLabel-payment_cod").classList.remove("d-none");
                }
                else{
                    deliveryCostSpan.dataset.deliveryCost = 0;
                    document.getElementById("deliveryCostSubsection").classList.add("d-none");
                    document.getElementById("paymentOptionLabel-payment_cod").classList.add("d-none");
                }

                finalPriceSpan.dataset.finalPrice = finalPrice;
                finalPriceSpan.textContent = finalPrice.toFixed(2) + " €";
            }
        });
    });

    document.querySelectorAll('input[name="paymentOption"]').forEach(input => {
        input.addEventListener('change', () => {
            if (input.checked) {
                finalPrice = Number(input.dataset.extraCost) + Number(subtotalSpan.dataset.subtotalPrice) + Number(deliveryCostSpan.dataset.deliveryCost);

                if(input.dataset.extraCost > 0){
                    document.getElementById("cashOnDeliveryCostSubsection").classList.remove("d-none");
                    paymentOptionCostSpan.dataset.paymentOptionCost = Number(input.dataset.extraCost);
                    paymentOptionCostSpan.textContent = Number(input.dataset.extraCost).toFixed(2) + " €";
                }
                else{
                    paymentOptionCostSpan.dataset.paymentOptionCost = 0;
                    document.getElementById("cashOnDeliveryCostSubsection").classList.add("d-none");
                }

                finalPriceSpan.dataset.finalPrice = finalPrice;
                finalPriceSpan.textContent = finalPrice.toFixed(2) + " €";
            }
        });
    });

    const summaryLoadingOverlay = document.getElementById("summaryLoadingOverlay");
    async function removeFromCartAndUpdateUI(cartItemId, cartItemContainerId) {
        summaryLoadingOverlay.classList.remove('d-none');

        const productContainer = document.getElementById("productsContainer");
        const cardItemContainer = document.getElementById(cartItemContainerId);

        const quantity = Number(cardItemContainer.dataset.initialQuantity);
        const price = Number(cardItemContainer.dataset.price);

        let result = await removeFromCart(cartItemId);
        if(!result){
            resultModal.setAttribute("popUpValue", "unknownError");
            showPopUpModal('resultModal', "Αποτυχία Ανανέωσης Προϊόντος", "Η ποσότητα του προϊόντος δεν μπόρεσε να ανανεωθεί.",
                "Αποτυχία", "Η ποσότητα του προϊόντος δεν μπόρεσε να ανανεωθεί.");
            summaryLoadingOverlay.classList.add('d-none');
            return;
        }

        if (cardItemContainer){
            cardItemContainer.remove();
        }

        let subtotalPrice = Number(subtotalSpan.dataset.subtotalPrice) || 0;
        subtotalPrice -= quantity * price;
        subtotalSpan.dataset.subtotalPrice = subtotalPrice;
        subtotalSpan.textContent = subtotalPrice.toFixed(2) + ' €';

        let finalPrice = Number(finalPriceSpan.dataset.finalPrice) || 0
        finalPrice -= quantity * price;
        finalPriceSpan.dataset.finalPrice = finalPrice;
        finalPriceSpan.textContent = finalPrice.toFixed(2) + ' €';

        if (productContainer.querySelectorAll('.card').length == 0) {
            localStorage.removeItem("cart");
            window.location.href = '@Url.Action("ViewCart", "Home")';
        }

        if(!document.querySelector('[id^="stockWarning"]')){
            document.getElementById("orderConfirmButton").classList.remove('disabled-look');
        }

        summaryLoadingOverlay.classList.add('d-none');
    }

    async function updateCartItemAndUpdateUI(cartItemId, cartItemContainerId) {
        summaryLoadingOverlay.classList.remove('d-none');
        const cardItemContainer = document.getElementById(cartItemContainerId);

        const initialQuantity = Number(cardItemContainer.dataset.initialQuantity);
        const quantity = Number(cardItemContainer.dataset.quantity);
        const price = Number(cardItemContainer.dataset.price);

        let subtotalPrice = Number(subtotalSpan.dataset.subtotalPrice) || 0;
        subtotalPrice = subtotalPrice + (quantity * price) - (initialQuantity * price);
        subtotalSpan.dataset.subtotalPrice = subtotalPrice;
        subtotalSpan.textContent = subtotalPrice.toFixed(2) + ' €';

        cardItemContainer.querySelector('[id^="cartItemFullPriceForItem"]').textContent = (quantity * price).toFixed(2) + ' €';

        let finalPrice = Number(finalPriceSpan.dataset.finalPrice) || 0
        finalPrice = finalPrice + (quantity * price) - (initialQuantity * price);
        finalPriceSpan.dataset.finalPrice = finalPrice;
        finalPriceSpan.textContent = finalPrice.toFixed(2) + ' €';

        let result = await updateCartItem(cartItemId, quantity);
        if(!result){
            resultModal.setAttribute("popUpValue", "unknownError");
            showPopUpModal('resultModal', "Αποτυχία Αλλαγής Ποσότητας", "Η ποσότητα του προϊόντος δεν μπόρεσε να αλλάξει. Παρακαλώ δοκιμάστε ξανά ή ανανεώστε την σελίδα.",
                "Αποτυχία", "Η ποσότητα του προϊόντος δεν μπόρεσε να αλλάξει. Παρακαλώ δοκιμάστε ξανά ή ανανεώστε την σελίδα.");
            summaryLoadingOverlay.classList.add('d-none');
            return;
        }

        const firstStockWarning = cardItemContainer.querySelector('[id^="stockWarning"]');
        if (firstStockWarning) {
            firstStockWarning.remove();
        }
        const cartItemQuantityBadgeSpan = cardItemContainer.querySelector('[id^="cartItemQuantityBadge"]');
        if(cartItemQuantityBadgeSpan){
            cartItemQuantityBadgeSpan.textContent = quantity;
        }

        if(!document.querySelector('[id^="stockWarning"]')){
            document.getElementById("orderConfirmButton").classList.remove('disabled-look');
        }

        cardItemContainer.classList.remove('border-warning');
        summaryLoadingOverlay.classList.add('d-none');
    }

    function stockWarningHtml(cartItemId, availableStock) {
        const outOfStock = availableStock === 0;

        return `
            <div class="stock-notice" id="stockWarning-${cartItemId}">
                <div class="stock-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="stock-content">
                    ${!outOfStock
                        ? `<span>Διαθέσιμα μόνο <strong>${availableStock}</strong> τεμ.</span>`
                        : `<span>Το προϊόν έχει εξαντληθεί</span>`
                    }

                    <div class="stock-actions">
                        ${!outOfStock ? `
                            <a class="stock-btn stock-btn-update"
                               id="updateCartItemButton_${cartItemId}"
                               data-available-stock="${availableStock}"
                               onclick="updateCartItemAndUpdateUI('${cartItemId}', 'cardId_${cartItemId}')">

                                <i class="fa-solid fa-arrows-rotate me-1 hide-icon-on-small"></i>

                                <span class="text-full">Ενημέρωση σε ${availableStock}</span>
                                <span class="text-mobile">Ενημέρωση</span>
                            </a>
                        ` : ""}

                        <a class="stock-btn stock-btn-remove"
                           id="removeCartItemButton_${cartItemId}"
                           onclick="removeFromCartAndUpdateUI('${cartItemId}', 'cardId_${cartItemId}')">
                            <i class="fa-solid fa-trash me-1 hide-icon-on-small"></i>Αφαίρεση
                        </a>
                    </div>
                </div>
            </div>
        `;
    }
</script>