        border-radius: 12px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .65rem;
        transition: background .2s, transform .15s;
    }

    .btn-confirm:hover {
        background: #e05300;
        transform: translateY(-1px);
        color: #fff;
    }

    .btn-confirm svg {
