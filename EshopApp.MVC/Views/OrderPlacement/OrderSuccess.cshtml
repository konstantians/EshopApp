@{
    ViewData["Title"] = "Order Success";
}

<script>
    //if no items are in the cart then return back to cart
    const cart = JSON.parse(localStorage.getItem("cart"));
    const orderData = JSON.parse(localStorage.getItem("orderData"));
    const orderAddress = orderData?.orderAddress;

    if (!cart?.cartItems?.length) {
        window.location.href = "/Home/ViewCart";
    }
    else if (!orderData?.orderAddress
        || !orderAddress.email || !orderAddress.firstName || !orderAddress.lastName
        || !orderAddress.country || !orderAddress.city || !orderAddress.postalCode || !orderAddress.address) {
        window.location.href = '@Url.Action("CustomerInformation", "OrderPlacement")';
    }
    else if (orderAddress.isShippingAddressDifferent && (
        !orderAddress.altEmail || !orderAddress.altFirstName || !orderAddress.altLastName
        || !orderAddress.altCountry || !orderAddress.altCity || !orderAddress.altPostalCode || !orderAddress.altAddress)) {
        window.location.href = '@Url.Action("CustomerInformation", "OrderPlacement")';
    }
    else if(!orderData.canProceedToConfirmation){
        window.location.href = '@Url.Action("CustomerInformation", "OrderPlacement")';
    }

    localStorage.removeItem("cart");
    localStorage.removeItem("orderData");
</script>

<style>
    .card-wrapper {
        max-width: 500px;
        margin:auto;
        width: 100%;
        text-align: center;
        padding: 0 1.5rem 2.5rem;
    }

