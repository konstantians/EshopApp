@model List<UiProduct>

@{
    ViewData["Title"] = "View Items";
    int carouselCount = 1;
}

<link href="~/css/filtersStyles.css" rel="stylesheet" />

<style>
    li.disabled {
        pointer-events: none; /* blocks clicks */
        opacity: 0.2; /* makes it look dimmed */
    }

    .card:hover {
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.3);
        /* cursor: pointer; */
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%23000' viewBox='0 0 16 16'%3E%3Cpath d='M11.354 1.646a.5.5 0 0 0-.708 0L4.5 8l6.146 6.354a.5.5 0 0 0 .708-.708L5.707 8l5.647-5.646a.5.5 0 0 0 0-.708z'/%3E%3C/svg%3E");
    }

    .carousel-control-next-icon {
        background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%23000' viewBox='0 0 16 16'%3E%3Cpath d='M4.646 1.646a.5.5 0 0 1 .708 0L11.5 8l-6.146 6.354a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z'/%3E%3C/svg%3E");
    }

    .discountContainer{
        width: 78%;
    }

    @@media(min-width: 576px) {
        .discountContainer {
            width: 85%;
        }
    }

    @@media(min-width: 768px) {
        .discountContainer {
            width: 88%;
        }
    }

    @@media(min-width: 992px) {
        .discountContainer {
            width: 84%;
        }
    }
</style>

<h1 class="text-center h3" style="font-weight:700;">ΠΡΟΪΟΝΤΑ</h1>
<hr style="color:#484848" class="d-none d-sm-block">

<button id="filterToggleButton" class="btn btn-primary rounded-0 d-xl-none px-3" style="position: fixed; top: 320px; left: 0px; z-index: 1050; transform: rotate(-90deg);
            transform-origin: top left; background-color:white !important; color: var(--accent-orange) !important; border: #aaa solid 1px; border-top:none; transition: left 0.4s ease;">
    Φίλτρα
</button>

<div class="row">
    <div class="col-3" id="filtersSection">
        <div class="card" style="position: sticky !important; top:135px; align-self:flex-start !important;" id="cardFilters">
            <div class="card-header d-none d-xl-block">
                <h4 class="text-center mb-0">Φίλτρα</h4>
            </div>
            <div class="card-body">
                <div class="p-3 border border-1 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label id="searchLabel" for="searchInput" class="mt-1">ΑΝΑΖΗΤΗΣΗ</label>
                        <div class="btn-group dropdown" role="group">
                            <button type="button" class="btn btn-primary"> <i id="searchButtonIconIndicator" class="fa-solid fa-box"></i> </button>
                            <button type="button" class="btn btn-dark dropdown-toggle" style="width:40px;" data-bs-toggle="dropdown" aria-expanded="false"></button>
                            <div class="dropdown-menu dropdown-menu-end py-0 dropdown-menu-custom-width" style="margin-top: 0 !important;">
                                <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode="name" data-search-mode-icon="fa-box">Αναζήτηση με Τίτλο<i class="fa-solid fa-box ms-2"></i></a>
                                <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode="code" data-search-mode-icon="fa-tag">Αναζήτηση με Κωδικό<i class="fa-solid fa-tag ms-2"></i></a>
                                <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode="sku" data-search-mode-icon="fa-hashtag">Αναζήτηση με SKU<i class="fa-solid fa-hashtag ms-2"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mt-3">
                        <input type="text" class="form-control" id="searchInput" value="">
                        <a class="btn btn-primary" id="searchButton"><i class="fas fa-search"></i></a>
                    </div>
                </div>

                @{
                    Dictionary<(decimal min, decimal max), int> priceRanges = new Dictionary<(decimal, decimal), int>
                    {
                        {(0, 20), 0},
                        {(20, 40), 0},
                        {(40, 60), 0},
                        {(60, 80), 0},
                        {(80, 100), 0},
                        {(100, 120), 0},
                        {(120, 140), 0},
                        {(140, 160), 0},
                        {(160, 180), 0},
                        {(180, 200), 0}
                    };

                    Dictionary<string, int> categoryVolumes = new Dictionary<string, int>();

                    List<(decimal min, decimal max)> intervals = priceRanges.Keys.ToList();
                }

                @foreach (UiProduct product in Model)
                {
                    foreach (UiVariant variant in product.Variants)
                    {
                        decimal price = variant.Price!.Value;
                        foreach (var key in intervals)
                        {
                            if (price >= key.min && price < key.max)
                            {
                                priceRanges[key]++;
                                break;
                            }
                        }
                    }

                    if (product.Categories is null || product.Categories.Count == 0)
                    {
                        if (categoryVolumes.TryGetValue("Καμία Κατηγορία", out int volume))
                            categoryVolumes["Καμία Κατηγορία"] += 1;
                        else
                            categoryVolumes["Καμία Κατηγορία"] = 1;
                        continue;
                    }

                    foreach (UiCategory category in product.Categories)
                    {
                        if (categoryVolumes.TryGetValue(category.Name!, out int volume))
                            categoryVolumes[category.Name!] += 1;
                        else
                            categoryVolumes[category.Name!] = 1;
                    }
                }

                <div class="custom-accordion-item">
                    <button class="custom-accordion-button" type="button" aria-expanded="false">
                        ΚΑΤΗΓΟΡΙΑ
                    </button>
                    <div class="custom-accordion-content" id="categoryFiltersUl">
                        <ul class="list-unstyled">
                            @foreach (KeyValuePair<string, int> categoryVolume in categoryVolumes)
                            {
                                <li class="toggle-check d-flex justify-content-between align-items-center px-2 py-1 hover-highlight" data-filter="@categoryVolume.Key">
                                    <label class="mb-0 text-smaller" style="cursor:pointer;">@categoryVolume.Key (@categoryVolume.Value)</label>
                                    <input type="checkbox" class="form-check-input rounded-0" style="cursor:pointer;">
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="custom-accordion-item">
                    <button class="custom-accordion-button" type="button" aria-expanded="false">
                        ΦΥΛΟ
                    </button>
                    <div class="custom-accordion-content">
                        <ul class="list-unstyled">
                            <li class="toggle-check d-flex justify-content-between align-items-center px-2 py-1 hover-highlight">
                                <label class="mb-0 text-smaller" style="cursor:pointer;">ΑΝΔΡΑΣ (1340)</label>
                                <input type="checkbox" class="form-check-input rounded-0" style="cursor:pointer;">
                            </li>
                            <li class="toggle-check d-flex justify-content-between align-items-center px-2 py-1 hover-highlight">
                                <label class="mb-0 text-smaller" style="cursor:pointer;">ΓΥΝΑΙΚΑ (537)</label>
                                <input type="checkbox" class="form-check-input rounded-0" style="cursor:pointer;">
                            </li>
                            <li class="toggle-check d-flex justify-content-between align-items-center px-2 py-1 li-disabled">
                                <label class="mb-0 text-smaller">ΑΓΟΡΙ (0)</label>
                                <input type="checkbox" class="form-check-input rounded-0" disabled>
                            </li>
                            <li class="toggle-check d-flex justify-content-between align-items-center px-2 py-1 li-disabled">
                                <label class="mb-0 text-smaller">ΚΟΡΙΤΣΙ (0)</label>
                                <input type="checkbox" class="form-check-input rounded-0" disabled>
                            </li>
                            <li class="toggle-check d-flex justify-content-between align-items-center px-2 py-1 li-disabled">
                                <label class="mb-0 text-smaller">UNISEX (0)</label>
                                <input type="checkbox" class="form-check-input rounded-0" disabled>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="custom-accordion-item" data-hide-on-product-view>
                    <button class="custom-accordion-button" type="button" aria-expanded="false">
                        ΤΙΜΗ
                    </button>
                    <div class="custom-accordion-content">
                        <ul class="list-unstyled" id="priceFiltersUl">
                            @foreach (var key in intervals)
                            {
                                string filterStyling = priceRanges[key] > 0 ? "hover-highlight" : "disabled";
                                <li class="toggle-check d-flex justify-content-between align-items-center px-2 py-1 @filterStyling" data-filter="@key" data-filter-interval-start="@key.min" data-filter-interval-end="@key.max">
                                    <label class="mb-0 text-smaller" style="cursor:pointer;">@key.min&euro; - @key.max&euro; (@priceRanges[key])</label>
                                    <input type="checkbox" class="form-check-input rounded-0" style="cursor:pointer;">
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-9" id="objectsSection">
        <div class="row mb-1 mb-sm-2 px-2 px-sm-0 px-md-0">
            <div class="col-12 col-md-6 px-1">
                <ul class="pagination justify-content-md-start justify-content-center align-items-center mb-1 mb-md-0 @(Model.Count > 18 ? "" : "d-none")" id="paginationUl" data-total-items="@Model.Count">
                    <li class="page-item me-1" id="goToFirstPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=0">
                            <span aria-hidden="true" class="text-md-biggest">«</span>
                        </a>
                    </li>
                    <li class="page-item me-1" id="goToPreviousPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=0">
                            <span class="text-md-biggest" aria-hidden="true">‹</span>
                        </a>
                    </li>
                    <li class="page-item active page-li">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">1</a>
                    </li>
                    <li class="page-item page-li @(Model.Count > 54 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">2</a>
                    </li>
                    <li class="page-item page-li @(Model.Count > 72 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">3</a>
                    </li>
                    <li class="page-item page-li @(Model.Count > 90 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">4</a>
                    </li>
                    <li class="page-item disabled @(Model.Count > 108 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">…</a>
                    </li>
                    <li class="page-item page-li">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">@Math.Ceiling((double)@Model.Count / 18) </a>
                    </li>
                    <li class="page-item ms-1" id="goToNextPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=1">
                            <span aria-hidden="true" class="text-md-biggest">›</span>
                        </a>
                    </li>
                    <li class="page-item ms-1" id="goToLastPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=1182">
                            <span aria-hidden="true" class="text-md-biggest">»</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-md-6 px-1 mb-1 mb-sm-0">
                <div class="d-flex gap-2 justify-content-md-end justify-content-sm-center justify-content-between">
                    <div class="dropdown option-dropdown">
                        <button class="btn dropdown-toggle rounded-0 text-md-bigger px-1 px-sm-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color:#F5F5F5;">
                            Προεπιλεγμένη Σειρά
                        </button>
                        <ul class="dropdown-menu py-0" id="sortingDropdown">
                            <li data-order="defaultOrder"><a class="dropdown-item" href="#">Προεπιλεγμένη Σειρά</a></li>
                            <li data-order="price" data-order-direction="descending" data-numeric data-hide-on-product-view><a class="dropdown-item" href="#">Τιμή Φθίνουσα Σειρά</a></li>
                            <li data-order="price" data-order-direction="ascending" data-numeric data-hide-on-product-view><a class="dropdown-item" href="#">Τιμή Αύξουσα Σειρά</a></li>
                        </ul>
                    </div>
                    <div class="dropdown option-dropdown">
                        <button class="btn dropdown-toggle rounded-0 text-md-bigger px-1 px-sm-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color:#F5F5F5;" id="pagesDropdown">
                            18 Ανά Σελίδα
                        </button>
                        <ul class="dropdown-menu py-0" id="itemsPerPageDropdown">
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(18)" href="#">18 Ανά Σελίδα</a></li>
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(36)" href="#">36 Ανά Σελίδα</a></li>
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(72)" href="#">72 Ανά Σελίδα</a></li>
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(120)" href="#">120 Ανά Σελίδα</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        @{
            string shouldItemsBeSeen = Model.Count == 0 ? "d-none" : "";
            string shouldBeSeen = Model.Count != 0 ? "d-none" : "";
        }
        <div class="row px-2 px-sm-0 px-md-0 @shouldItemsBeSeen" id="itemsContainer">
            @foreach (UiProduct product in Model)
            {
                string activeClass = "active";

                if(product.Variants is null || product.Variants.Count == 0)
                    continue;

                <div class="col-xl-4 col-lg-4 col-6 m-0 px-1">
                    <div class="card mb-2" style="max-height:620px; width:auto;">
                        <div id="cardCarousel-@carouselCount" class="carousel slide" data-bs-interval="false">
                            <div class="carousel-inner">
                                @foreach (UiVariantImage variantImage in product.Variants[0].VariantImages)
                                {
                                    <a class="carousel-item @activeClass" asp-controller="Home" asp-action="ViewItem" asp-route-id="@product.Id">
                                        <img src="~/DynamicImages/@variantImage.Image!.ImagePath" class="d-block w-100 img-fluid" style="min-height: 380px; max-height: 380px;">
                                    </a>
                                    activeClass = "";
                                }

                                @if(product.Variants[0].VariantImages.Count == 0)
                                {
                                    <a class="carousel-item @activeClass" asp-controller="Home" asp-action="ViewItem" asp-route-id="@product.Id">
                                        <img src="~/Images/noProductImage.jpg" class="d-block w-100 img-fluid" style="min-height: 380px; max-height: 380px;">
                                    </a>
                                }
                            </div>
                            @if(product.Variants[0].VariantImages.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#cardCarousel-@carouselCount" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true" style="color:black"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#cardCarousel-@carouselCount" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true" style="color:black"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            }
                        </div>
                        <div class="card-body py-2">
                            <span style="font-weight:600; color:#272727; line-height:1.2; display:block; font-size: 16px;"> @product.Name </span>
                            <div class="d-flex justify-content-between align-items-center mt-3 position-relative">
                                @if (product.Variants[0].Discount is not null)
                                {
                                    decimal? originalPrice = product.Variants[0].Price;
                                    decimal? discountedPrice = originalPrice - (originalPrice * product.Variants[0].Discount!.Percentage / 100);

                                    <span style="position:absolute; top:-13px; left:0;" class="d-flex justify-content-between discountContainer">
                                        <span style="text-decoration: line-through; font-size:14px; color:#999;"> @originalPrice €</span>
                                         <span style="width:0;height:0;border-top:35px solid var(--accent-orange);border-left:35px solid transparent;position:relative;">
        
                                            <span style="position:absolute;top:-32px;left:-24px;color:white;font-size:10px;font-weight:700;transform:rotate(45deg);">
                                                -@product.Variants[0].Discount!.Percentage%
                                            </span>
                                        </span>
                                    </span>

                                    <span class="text-info" style="font-size:24px;">
                                        @discountedPrice €
                                    </span>
                                }
                                else{
                                    <span class="text-info" style="font-size:24px;">@product.Variants[0].Price €</span>
                                }
                                <a asp-controller="Home" asp-action="ViewItem" asp-route-id="@product.Id">
                                    <i class="fa-solid fa-cart-plus text-info" style="font-size:24px;"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                carouselCount++;
            }
        </div>
        <div class="row px-2 px-sm-0 px-md-0 @shouldBeSeen" id="noItemsContainer">
            <div id="emptyStateBanner">
                <div class="card border-1 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fa-solid fa-box-open fa-4x text-secondary mb-3"></i>

                        <h4 id="emptyStateTitle" class="mb-2">
                            Δεν βρέθηκαν προϊόντα
                        </h4>

                        <p id="emptyStateDescription" class="text-muted mb-4">
                            Δεν υπάρχουν προϊόντα που να ταιριάζουν με τα επιλεγμένα φίλτρα.
                        </p>

                        @*<a class="btn btn-primary"
                           asp-controller="ProductManagement"
                           asp-action="CreateProduct">
                            Δημιουργία Προϊόντος
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* <script type="text/javascript" src="~/js/customModals.js"></script> *@
    <script type="text/javascript" src="~/js/filtersBehaviour.js"></script>
    <script type="text/javascript" src="~/js/filtersRepeatedNonStaticCode.js"></script>

    <script>
        const dynamicImagesUrl = '@Url.Content("~/DynamicImages/")';
        const noProductImageUrl = '@Url.Content("~/Images/noProductImage.jpg")';

        let products = JSON.parse('@Html.Raw(Json.Serialize(Model))');
        let variantsWithProductInformation = [];

        for (let i = 0; i < products.length; i++) {
            if(products[i].variants.length == 0){
                continue;
            }

            let variantWithProductInformation = {
                originalIndex: i,
                productId: products[i].id,
                categories: products[i].categories && products[i].categories.length > 0 ? products[i].categories : [{ name: "Καμία Κατηγορία" }],
                name: products[i].name,
                code: products[i].code,
                variantId: products[i].variants[0].id,
                sku: products[i].variants[0].sku,
                price: products[i].variants[0].price,
                unitsInStock: products[i].variants[0].unitsInStock,
                variantImages: products[i].variants[0].variantImages,
                isFilteredBySearch: false,
                protectedByCategoryLis: [],
                protectedByPriceLis: [],
                protectedByUnitsInStockLis: [],
                discount: products[i].variants[0].discount
            };

            variantsWithProductInformation.push(variantWithProductInformation);
        }

        let isCategoryFilterActive = { value: 0 };
        let isPriceFilterActive = { value: 0 };
        let isUnitsInStockFilterActive = { value: 0 };

        /* pagination change */
        document.addEventListener('pagination:pageChange', function (event) {
            renderProductCards(variantsWithProductInformation);
        });

        /* items per page change */
        document.addEventListener('itemsPerPage:changed', function (event) {
            renderProductCards(variantsWithProductInformation);
        });

        function countHowManyEntriesAreLeftUnfilteredAndUpdatePagination() {
            let count = 0;
            itemsLeftForCheckBoxCounts = [];
            variantsWithProductInformation.forEach(variantWithProductInformation => {
                let blockedBy = []
                if (isPriceFilterActive.value !== 0 && variantWithProductInformation.protectedByPriceLis.length === 0) {
                    blockedBy.push("price");
                }

                if(isCategoryFilterActive.value !== 0 && variantWithProductInformation.protectedByCategoryLis.length === 0){
                    blockedBy.push("category");
                }

                if(blockedBy.length === 0){
                    itemsLeftForCheckBoxCounts.push({item: variantWithProductInformation, blockedBy: "nothing"});
                }
                else if(blockedBy.length === 1){
                    itemsLeftForCheckBoxCounts.push({item: variantWithProductInformation, blockedBy: blockedBy[0]});
                }

                let filteredByCheckBox = blockedBy.length > 0;

                if (!variantWithProductInformation.isFilteredBySearch && !filteredByCheckBox) {
                    count++;
                }
            });

            updateEmptyState(count > 0);
            updateTotalItems(count); //this exists in filtersBehaviour.js
            updateFilterCheckBoxesStylingAndCounts(itemsLeftForCheckBoxCounts);
        }

        function priceFilterCheckboxCheckedProcedures(liPriceRange, li){
            variantsWithProductInformation.forEach(variantWithProductInformation => {
                const variantPrice = variantWithProductInformation.price;
                let startIntervalPrice = parseFloat(li.dataset.filterIntervalStart);
                let endIntervalPrice = parseFloat(li.dataset.filterIntervalEnd);
                if (variantPrice >=  startIntervalPrice && variantPrice < endIntervalPrice) {
                    variantWithProductInformation.protectedByPriceLis.push(liPriceRange);
                }
            });

            isPriceFilterActive.value++;
        }

        function categoryFilterCheckboxCheckedProcedures(liCategoryName, li) {
            variantsWithProductInformation.forEach(variantWithProductInformation => {
                const categories = variantWithProductInformation.categories || [];

                const hasCategory = categories.some(category => (category.name || "").toLowerCase().trim() === liCategoryName.toLowerCase().trim());

                if (hasCategory) {
                    variantWithProductInformation.protectedByCategoryLis.push(liCategoryName);
                }
            });

            isCategoryFilterActive.value++;
        }

        function updateFilterCheckBoxesStylingAndCounts(itemsLeftForCheckBoxCounts){
            let priceRanges = new Map([
              [[0, 20], 0],
              [[20, 40], 0],
              [[40, 60], 0],
              [[60, 80], 0],
              [[80, 100], 0],
              [[100, 120], 0],
              [[120, 140], 0],
              [[140, 160], 0],
              [[160, 180], 0],
              [[180, 200], 0],
            ]);

            let categoryVolumes = new Map();
            let priceIntervals = Array.from(priceRanges.keys());

            for (let itemAndBlockedBy of itemsLeftForCheckBoxCounts){
                if(itemAndBlockedBy.blockedBy == "nothing" || itemAndBlockedBy.blockedBy == "price"){
                    let price = itemAndBlockedBy.item.price;
                    for (let key of priceIntervals) {
                        let [min, max] = key;
                        if (price >= min && price < max) {
                            priceRanges.set(key, priceRanges.get(key) + 1);
                            break;
                        }
                    }
                }

                if(itemAndBlockedBy.blockedBy == "nothing" || itemAndBlockedBy.blockedBy == "category"){
                    if (!itemAndBlockedBy.item.categories || itemAndBlockedBy.item.categories.length === 0) {
                        categoryVolumes.set("Καμία Κατηγορία", (categoryVolumes.get("Καμία Κατηγορία") || 0) + 1);
                    }
                    else{
                        for (let category of itemAndBlockedBy.item.categories) {
                            categoryVolumes.set(category.name, (categoryVolumes.get(category.name) || 0) + 1);
                        }
                    }
                }
            }

            updateIntervalCheckBoxLis('price', priceRanges, '€');
            updateValueCheckBoxLi('category', categoryVolumes);
        }

        //these 2 functions are used by renderTable function in filtersRepeatedNonStaticCode
        function checkIfItemFilteredByCheckboxFilters(item){
            return (isCategoryFilterActive.value > 0 && item.protectedByCategoryLis.length === 0) || (isPriceFilterActive.value > 0 && item.protectedByPriceLis.length === 0);
        }

        function updateEmptyState(hasItems) {
            let cont = document.getElementById('itemsContainer');

            const banner = document.getElementById('noItemsContainer');

            if (hasItems) {
                cont.classList.remove('d-none');
                banner.classList.add('d-none');
            }
            else {
                cont.classList.add('d-none');
                banner.classList.remove('d-none');

                document.getElementById('emptyStateTitle').textContent = "Δεν βρέθηκαν προϊόντα";
                document.getElementById('emptyStateDescription').textContent = "Δεν υπάρχουν προϊόντα που να ταιριάζουν με τα επιλεγμένα φίλτρα ή την αναζήτηση."
            }
        }

        function renderProductCards(items) {
            let itemsContainer = document.getElementById('itemsContainer');
            itemsContainer.innerHTML = "";

            const start = (currentPage - 1) * itemsPerPage;
            let counter = 0;
            let renderedCount = 0;

            for (const item of items) {
                if (renderedCount >= itemsPerPage) {
                    break;
                };

                if (item.isFilteredBySearch) {
                    continue;
                }

                if (checkIfItemFilteredByCheckboxFilters(item)) {
                    continue;
                }

                if (counter < start) {
                    counter++;
                    continue;
                }

                addCardToContainer(item);

                renderedCount++;
                counter++;
            }
        }

        function addCardToContainer(item){
            let itemsContainer = document.getElementById('itemsContainer');
            const colDiv = document.createElement("div");
            colDiv.className = "col-xl-4 col-lg-4 col-6 m-0 px-1";

            // Card wrapper
            const cardDiv = document.createElement("div");
            cardDiv.className = "card mb-2";
            cardDiv.style.maxHeight = "620px";
            cardDiv.style.width = "auto";

            // Carousel
            const carouselId = `cardCarousel-${crypto.randomUUID()}`;
            const carouselDiv = document.createElement("div");
            carouselDiv.id = carouselId;
            carouselDiv.className = "carousel slide";
            carouselDiv.setAttribute("data-bs-interval", "false");

            // Carousel inner
            const carouselInner = document.createElement("div");
            carouselInner.className = "carousel-inner";

            // Case where the variant has no images
            if(!item.variantImages || item.variantImages.length == 0){
                let carouselOnlyItem = document.createElement("a");
                carouselOnlyItem.href = `/Home/ViewItem?id=${item.productId}`;
                carouselOnlyItem.className = "carousel-item active";
                let carouselOnlyImage = document.createElement("img");
                carouselOnlyImage.src = noProductImageUrl;
                carouselOnlyImage.className = "d-block w-100 img-fluid";
                carouselOnlyImage.style.minHeight = "380px";
                carouselOnlyImage.style.maxHeight = "380px";
                carouselOnlyItem.appendChild(carouselOnlyImage);
                carouselInner.appendChild(carouselOnlyItem);
            }
            // Otherwise
            else{
                item.variantImages.forEach((variantImage, index) => {
                    let carouselItem = document.createElement("a");
                    carouselItem.href = `/Home/ViewItem?id=${item.productId}`;
                    carouselItem.className = "carousel-item";
                    if (index === 0) carouselItem.classList.add("active");

                    let carouselItemImage = document.createElement("img");
                    carouselItemImage.src = dynamicImagesUrl + variantImage.image.imagePath;
                    carouselItemImage.className = "d-block w-100 img-fluid";
                    carouselItemImage.style.minHeight = "380px";
                    carouselItemImage.style.maxHeight = "380px";
                    carouselItem.appendChild(carouselItemImage);
                    carouselInner.appendChild(carouselItem);
                });
            }

            // Carousel controls
            const prevBtn = document.createElement("button");
            prevBtn.className = "carousel-control-prev";
            prevBtn.type = "button";
            prevBtn.setAttribute("data-bs-target", "#" + carouselId);
            prevBtn.setAttribute("data-bs-slide", "prev");
            prevBtn.innerHTML = `
                <span class="carousel-control-prev-icon" aria-hidden="true" style="color:black"></span>
                <span class="visually-hidden">Previous</span>
            `;

            const nextBtn = document.createElement("button");
            nextBtn.className = "carousel-control-next";
            nextBtn.type = "button";
            nextBtn.setAttribute("data-bs-target", "#" + carouselId);
            nextBtn.setAttribute("data-bs-slide", "next");
            nextBtn.innerHTML = `
                <span class="carousel-control-next-icon" aria-hidden="true" style="color:black"></span>
                <span class="visually-hidden">Next</span>
            `;

            // Assemble carousel
            carouselDiv.appendChild(carouselInner);
            if(item.variantImages && item.variantImages.length > 1){
                carouselDiv.appendChild(prevBtn);
                carouselDiv.appendChild(nextBtn);
            }

            // Card body
            const cardBody = document.createElement("div");
            cardBody.className = "card-body py-2";
            const title = document.createElement("span");
            title.style.cssText = "font-weight:600; color:#272727; line-height:1.2; display:block; font-size:17px;";
            title.textContent = item.name;

            const priceRow = document.createElement("div");
            priceRow.className = "d-flex justify-content-between align-items-center mt-3 position-relative";

            // LEFT SIDE (discount if exists + price)
            const left = document.createElement("div");

            if (item.discount) {

                const originalPrice = item.price;
                const discountedPrice = originalPrice - (originalPrice * item.discount.percentage / 100);

                const discountContainer = document.createElement("span");
                discountContainer.style.position = "absolute";
                discountContainer.style.top = "-13px";
                discountContainer.style.left = "0";
                discountContainer.className = "d-flex justify-content-between discountContainer";

                const original = document.createElement("span");
                original.style.textDecoration = "line-through";
                original.style.fontSize = "14px";
                original.style.color = "#999";
                original.textContent = originalPrice.toFixed(2) + " €";

                const badge = document.createElement("span");
                badge.style.width = "0";
                badge.style.height = "0";
                badge.style.borderTop = "35px solid var(--accent-orange)";
                badge.style.borderLeft = "35px solid transparent";
                badge.style.position = "relative";

                const percent = document.createElement("span");
                percent.style.position = "absolute";
                percent.style.top = "-32px";
                percent.style.left = "-24px";
                percent.style.color = "white";
                percent.style.fontSize = "10px";
                percent.style.fontWeight = "700";
                percent.style.transform = "rotate(45deg)";
                percent.textContent = "-" + item.discount.percentage + "%";

                badge.appendChild(percent);
                discountContainer.appendChild(original);
                discountContainer.appendChild(badge);

                const finalPrice = document.createElement("span");
                finalPrice.className = "text-info";
                finalPrice.style.fontSize = "24px";
                finalPrice.textContent = discountedPrice.toFixed(2) + " €";

                left.appendChild(discountContainer);
                left.appendChild(finalPrice);

            } else {

                const price = document.createElement("span");
                price.className = "text-info";
                price.style.fontSize = "24px";
                price.textContent = item.price.toFixed(2) + " €";

                left.appendChild(price);
            }

            // RIGHT SIDE (cart)
            const cartLink = document.createElement("a");
            cartLink.href = `/Home/ViewItem?id=${item.productId}`;
            cartLink.innerHTML = `<i class="fa-solid fa-cart-plus text-info" style="font-size:24px;"></i>`;

            // assemble row
            priceRow.appendChild(left);
            priceRow.appendChild(cartLink);

            // Assemble card body
            cardBody.appendChild(title);
            cardBody.appendChild(priceRow);
            cardDiv.appendChild(carouselDiv);
            cardDiv.appendChild(cardBody);
            colDiv.appendChild(cardDiv);
            itemsContainer.appendChild(colDiv);
            updateObjectsContainer();
        }

        setUpSortingDropdownListeners(variantsWithProductInformation, renderProductCards);
        setUpSearchInputMode(variantsWithProductInformation, countHowManyEntriesAreLeftUnfilteredAndUpdatePagination, renderProductCards);
        setUpSearchInput(variantsWithProductInformation, countHowManyEntriesAreLeftUnfilteredAndUpdatePagination, renderProductCards);
        setUpCheckBoxFilterUl('priceFiltersUl', priceFilterCheckboxCheckedProcedures, 'protectedByPriceLis', isPriceFilterActive, variantsWithProductInformation, countHowManyEntriesAreLeftUnfilteredAndUpdatePagination, renderProductCards);
        setUpCheckBoxFilterUl('categoryFiltersUl', categoryFilterCheckboxCheckedProcedures, 'protectedByCategoryLis', isCategoryFilterActive, variantsWithProductInformation, countHowManyEntriesAreLeftUnfilteredAndUpdatePagination, renderProductCards);

        /* ------------------------------------- */

        document.querySelectorAll('.custom-accordion-button').forEach(button => {
            button.addEventListener('click', function () {
                const content = this.nextElementSibling;
                const isExpanded = content.classList.contains('expanded');

                this.setAttribute('aria-expanded', !isExpanded);
                this.classList.toggle('collapsed', !isExpanded);
                content.classList.toggle('expanded', !isExpanded);
            });
        });

        let itemsContainer = document.getElementById('itemsContainer');

        function updateObjectsContainer() {
            if (window.innerWidth < 1650) {
                objectsSection.classList.remove('col-xl-9');
                objectsSection.classList.add('col-xl-8');

                Array.from(itemsContainer.children).forEach(cardItem => {
                    cardItem.classList.remove('col-xl-2');
                    cardItem.classList.remove('col-xl-3');
                    cardItem.classList.add('col-xl-4');
                });
            }
            else if (window.innerWidth < 2350) {
                objectsSection.classList.add('col-xl-9');
                objectsSection.classList.remove('col-xl-8');

                Array.from(itemsContainer.children).forEach(cardItem => {
                    cardItem.classList.remove('col-xl-2');
                    cardItem.classList.add('col-xl-3');
                    cardItem.classList.remove('col-xl-4');
                });
            }
            //for very big screens
            else {
                objectsSection.classList.add('col-xl-9');
                objectsSection.classList.remove('col-xl-8');

                Array.from(itemsContainer.children).forEach(cardItem => {
                    cardItem.classList.add('col-xl-2');
                    cardItem.classList.remove('col-xl-3');
                    cardItem.classList.remove('col-xl-4');
                });
            }
        }

        window.addEventListener("load", updateObjectsContainer);
        window.addEventListener("resize", updateObjectsContainer);
    </script>
}