@model ManageCategoryViewModel

@{
    ViewData["Title"] = "Manage Categories";
}

<style>
    .card:hover {
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.3);
    }

    .custom-negative-margin {
        margin-top: -15px;
    }

    @@media (max-width : 768px) {
        .custom-negative-margin {
            margin-top: 0;
        }
    }
</style>

<link href="~/css/filtersStyles.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/slim-select@1.27.1/dist/slimselect.min.css" rel="stylesheet" />
<link href="~/css/multiSelectStyles.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.css" />

<div class="row mb-3">
    <div class="col-8 offset-2 col-sm-6 offset-sm-3 col-lg-8 offset-lg-2 text-center">
        <h3 class="mb-0 d-none" id="mainPageTitle">Κατηγορίες Εφαρμογής</h3>
    </div>
    <div class="col-2 col-sm-3 col-lg-2 m-0 text-end px-2 px-sm-0 px-lg-2">
        <a class="btn btn-outline-primary border border-1 d-none px-2 py-1" id="createCategoryPromptButton" data-bs-toggle="modal" data-bs-target="#createCategoryModal">Δημιουργία Κατηγορίας</a>
    </div>
</div>

<button id="filterToggleButton" class="btn btn-primary rounded-0 d-xl-none px-3" style="position: fixed; top: 320px; left: 0px; z-index: 1050; transform: rotate(-90deg);
            transform-origin: top left; background-color:white !important; color: var(--accent-orange) !important; border: #aaa solid 1px; border-top:none; transition: left 0.4s ease;">
    Φίλτρα
</button>

<div class="row">
    <div class="col-3" id="filtersSection">
        <div class="card" style="position: sticky !important; top:135px; align-self:flex-start !important;" id="cardFilters">
            <div class="card-header d-none d-xl-block">
                <h4 class="text-center mb-0">Φίλτρα</h4>
            </div>
            <div class="card-body">
                <div class="p-3 border border-1 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label id="searchLabel" for="searchInput" class="mt-1">ΑΝΑΖΗΤΗΣΗ</label>
                        <div class="btn-group dropdown" role="group">
                            <button type="button" class="btn btn-primary" style="width:40px;"> <i id="searchButtonIconIndicator" class="fa-solid fa-box-archive"></i> </button>
                            <button type="button" class="btn btn-dark dropdown-toggle" style="width:40px;" data-bs-toggle="dropdown" aria-expanded="false"></button>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-custom-width py-0" style="margin-top: 0 !important;">
                                <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode="name" data-search-mode-icon="fa-box-archive">Αναζήτηση με Τίτλο<i class="fa-solid fa-box-archive ms-2"></i></a>
                                <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode="id" data-search-mode-icon="fa-tag">Αναζήτηση με Id<i class="fa-solid fa-tag ms-2"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mt-3">
                        <input type="text" class="form-control" id="searchInput" value="">
                        <a class="btn btn-primary" id="searchButton"><i class="fas fa-search"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-9" id="objectsSection">
        <div class="row mb-1 mb-sm-2 px-2 px-sm-0 px-lg-2">
            <div class="col-12 col-md-6 px-0">
                <ul class="pagination justify-content-md-start justify-content-center align-items-center mb-1 mb-md-0 @(Model.Categories.Count > 18 ? "" : "d-none")" id="paginationUl" data-total-items="@Model.Categories.Count">
                    <li class="page-item me-1" id="goToFirstPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=0">
                            <span aria-hidden="true" class="text-md-biggest">«</span>
                        </a>
                    </li>
                    <li class="page-item me-1" id="goToPreviousPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=0">
                            <span class="text-md-biggest" aria-hidden="true">‹</span>
                        </a>
                    </li>
                    <li class="page-item active page-li">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">1</a>
                    </li>
                    <li class="page-item page-li @(Model.Categories.Count > 54 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">2</a>
                    </li>
                    <li class="page-item page-li @(Model.Categories.Count > 72 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">3</a>
                    </li>
                    <li class="page-item page-li @(Model.Categories.Count > 90 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">4</a>
                    </li>
                    <li class="page-item disabled @(Model.Categories.Count > 108 ? "" : "d-none")">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">…</a>
                    </li>
                    <li class="page-item page-li">
                        <a class="page-link no-background text-md-bigger" style="padding-right:3px !important; padding-left:3px !important;" href="#">@Math.Ceiling((double)@Model.Categories.Count / 18) </a>
                    </li>
                    <li class="page-item ms-1" id="goToNextPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=1">
                            <span aria-hidden="true" class="text-md-biggest">›</span>
                        </a>
                    </li>
                    <li class="page-item ms-1" id="goToLastPaginationLi">
                        <a class="page-link special rounded-0" style="padding-top:4px !important; padding-bottom:4px !important; width:35px;" href="?page=1182">
                            <span aria-hidden="true" class="text-md-biggest">»</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-md-6 px-0 mb-1 mb-sm-0">
                <div class="d-flex gap-2 justify-content-md-end justify-content-sm-center justify-content-between">
                    <div class="dropdown option-dropdown">
                        <button class="btn dropdown-toggle rounded-0 text-md-bigger px-1 px-sm-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color:#F5F5F5;">Προεπιλεγμένη Σειρά</button>
                        <ul class="dropdown-menu py-0 dropdown-menu-custom-width" id="sortingDropdown">
                            <li data-order="defaultOrder" data-order-direction="ascending"><a class="dropdown-item" href="#">Προεπιλεγμένη Σειρά</a></li>
                            <li data-order="nameOrder" data-order-direction="ascending"><a class="dropdown-item" href="#">Αλφαβητικά κατά Τίτλο</a></li>
                        </ul>
                    </div>
                    <div class="dropdown option-dropdown">
                        <button class="btn dropdown-toggle rounded-0 text-md-bigger px-1 px-sm-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color:#F5F5F5;" id="pagesDropdown">18 Ανά Σελίδα</button>
                        <ul class="dropdown-menu py-0 dropdown-menu-custom-width">
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(18)" href="#">18 Ανά Σελίδα</a></li>
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(36)" href="#">36 Ανά Σελίδα</a></li>
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(72)" href="#">72 Ανά Σελίδα</a></li>
                            <li><a class="dropdown-item" onclick="updateItemsPerPage(120)" href="#">120 Ανά Σελίδα</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="row px-2 px-sm-0 px-md-0 px-lg-2" id="itemsContainer">
            <div class="table-responsive w-100 p-0">
                <table class="table table-hover table-striped" id="categoriesTable">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th class="text-nowrap">Τίτλος Κατηγορίας</th>
                            <th class="text-nowrap">Προϊόντα Στην Κατηγορία</th>
                            <th>Επεξεργασία</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int counter = 0;
                        }
                        @foreach (UiCategory category in Model.Categories)
                        {
                            if (counter > 9)
                                break;

                            <tr>
                                <td class="text-nowrap">@category.Id</td>
                                <td class="text-nowrap">@category.Name</td>
                                <td class="text-nowrap">@category.Products.Count</td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-primary me-2" data-bs-toggle="modal" data-bs-target="#editCategoryModal-@category.Id"><i class="fas fa-pen"></i></a>
                                    <a class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#deleteCategoryConfirmationModal-@category.Id"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>

                            counter++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade custom-center-modal" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" method="post" asp-controller="categoryManagement" asp-action="CreateCategory" id="createCategoryForm">
            <div class="modal-header">
                <h5 class="modal-title">Δημιουργία Κατηγορίας</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <label asp-for="CreateCategoryViewModel.Name" class="form-label"><i class="fa-solid fa-box-archive me-2"></i>Τίτλος Κατηγορίας</label>
                    <input class="form-control" asp-for="CreateCategoryViewModel.Name" type="text" data-custom-validation="false">
                    <span asp-validation-for="CreateCategoryViewModel.Name" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center" id="searchButtonIconIndicatorContainerCreateCategory">
                    <label for="searchInputCreateCategory" class="mt-1">ΑΝΑΖΗΤΗΣΗ</label>
                    <div class="btn-group dropdown" role="group">
                        <button type="button" class="btn btn-primary" style="width:40px;"> <i id="searchButtonIconIndicatorCreateCategory" class="fa-solid fa-box-archive"></i> </button>
                        <button type="button" class="btn btn-dark dropdown-toggle" style="width:40px;" data-bs-toggle="dropdown" aria-expanded="false"></button>
                        <div class="dropdown-menu dropdown-menu-end py-0 dropdown-menu-custom-width" style="margin-top: 0 !important;">
                            <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode-X="name" data-search-mode-icon-X="fa-box-archive">Αναζήτηση με Τίτλο<i class="fa-solid fa-box-archive ms-2"></i></a>
                            <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode-X="code" data-search-mode-icon-X="fa-tag">Αναζήτηση με Κωδικό<i class="fa-solid fa-tag ms-2"></i></a>
                        </div>
                    </div>
                </div>
                <div class="input-group mt-2">
                    <input type="text" class="form-control" id="searchInputCreateCategory" value="">
                    <a class="btn btn-primary" id="searchButtonCreateCategory"><i class="fas fa-search"></i></a>
                </div>
                <div class="table-responsive w-100 p-0 custom-negative-margin">
                    <table class="table table-hover table-striped" id="createCategoryTable">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-nowrap">Κωδικός Προϊόντος</th>
                                <th class="text-nowrap">Τίτλος Προϊόντος</th>
                                <th class="text-nowrap">Επιλογή</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 0;
                            }
                            @foreach (UiProduct product in Model.Products)
                            {
                                if (counter > 17)
                                    break;

                                <tr>
                                    <td class="text-nowrap">@product.Code</td>
                                    <td class="text-nowrap">@product.Name</td>
                                    <td class="text-center">
                                        <div class="form-check d-flex justify-content-center align-items-center">
                                            <input class="form-check-input external-table-checkbox" type="checkbox" value="@product.Id" />
                                        </div>
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                    <input asp-for="CreateCategoryViewModel.ProductIds" hidden>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ακύρωση</button>
                <button type="submit" class="btn btn-primary" id="createCategoryButton" data-testid="createCategoryButton">Συνέχεια</button>
            </div>
        </form>
    </div>
</div>

@for(int i = 0; i < Model.UpdateCategoryViewModel.Count; i++)
{
    UpdateCategoryViewModel updateCategoryViewModel = Model.UpdateCategoryViewModel[i];
    <div class="modal fade custom-center-modal" id="deleteCategoryConfirmationModal-@updateCategoryViewModel.Id" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" method="post" asp-controller="categoryManagement" asp-action="DeleteCategory" id="deleteCategoryForm-@updateCategoryViewModel.Id">
                <div class="modal-header">
                    <h5 class="modal-title">Επιβεβαίωση Διαγραφής Κατηγορίας</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <strong style="font-size: 18px;">Η παρακάτω ενέργεια δεν είναι αντιστρέψιμη!</strong>
                    <p>
                        Αν είστε σίγουροι πως θέλετε να διαγράψατε την συγκεκριμένη κατηγορία παρακαλώ συμπληρώστε τον τίτλο της κατηγορίας και πατήστε συνέχεια.
                    </p>
                    <label for="modalDeleteCategoryInput-@updateCategoryViewModel.Id" class="form-label"><i class="fa-solid fa-box-archive me-2"></i>Τίτλος Κατηγορίας</label>
                    <input class="form-control" id="modalDeleteCategoryInput-@updateCategoryViewModel.Id" type="text" data-custom-validation="false" data-testid="emailInput" data-category-name="@updateCategoryViewModel.Name">
                    <span id="modalDeleteCategoryValidationSpan-@updateCategoryViewModel.Id" class="text-danger"></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-testid="cancelDeleteCategoryButton-@updateCategoryViewModel.Id">Ακύρωση</button>
                    <button type="submit" class="btn btn-primary" id="deleteCategoryButton-@updateCategoryViewModel.Id" data-testid="deleteCategoryButton-@updateCategoryViewModel.Id">Συνέχεια</button>
                </div>
                <input name="categoryId" value="@updateCategoryViewModel.Id" hidden />
            </form>
        </div>
    </div>

    <div class="modal fade custom-center-modal" id="editCategoryModal-@updateCategoryViewModel.Id" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" method="post" asp-controller="CategoryManagement" asp-action="EditCategory" id="editCategoryForm-@updateCategoryViewModel.Id">
                <div class="modal-header">
                    <h5 class="modal-title">Επεξεργασία Κατηγορίας</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <label for="updateCategoryViewModel_Id-@updateCategoryViewModel.Name" class="form-label"><i class="fa-solid fa-box-archive me-2"></i>Τίτλος Κατηγορίας</label>
                        <input class="form-control" asp-for="@updateCategoryViewModel.Name" id="updateCategoryViewModel_Name-@updateCategoryViewModel.Id" type="text" data-custom-validation="false">
                        <span asp-validation-for="@updateCategoryViewModel.Name" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center" id="searchButtonIconIndicatorContainerUpdateCategory-@updateCategoryViewModel.Id">
                        <label for="searchInputUpdateCategory-@updateCategoryViewModel.Id" class="mt-1">ΑΝΑΖΗΤΗΣΗ</label>
                        <div class="btn-group dropdown" role="group">
                            <button type="button" class="btn btn-primary" style="width:40px;"> <i id="searchButtonIconIndicatorUpdateCategory-@updateCategoryViewModel.Id" class="fa-solid fa-box-archive"></i> </button>
                            <button type="button" class="btn btn-dark dropdown-toggle" style="width:40px;" data-bs-toggle="dropdown" aria-expanded="false"></button>
                            <div class="dropdown-menu dropdown-menu-end py-0 dropdown-menu-custom-width" style="margin-top: 0 !important;">
                                <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode-X="name" data-search-mode-icon-X="fa-box-archive">Αναζήτηση με Τίτλο<i class="fa-solid fa-box-archive ms-2"></i></a>
                                <a class="dropdown-item d-flex justify-content-between align-items-center" href="#" data-search-mode-X="code" data-search-mode-icon-X="fa-tag">Αναζήτηση με Κωδικό<i class="fa-solid fa-tag ms-2"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mt-2">
                        <input type="text" class="form-control" id="searchInputUpdateCategory-@updateCategoryViewModel.Id" value="">
                        <a class="btn btn-primary" id="searchButtonUpdateCategory-@updateCategoryViewModel.Id"><i class="fas fa-search"></i></a>
                    </div>
                    <div class="table-responsive w-100 p-0 custom-negative-margin">
                        <table class="table table-hover table-striped" id="updateCategoryTable-@updateCategoryViewModel.Id">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-nowrap">Κωδικός Προϊόντος</th>
                                    <th class="text-nowrap">Τίτλος Προϊόντος</th>
                                    <th class="text-nowrap">Επιλογή</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 0;
                                }
                                @foreach (UiProduct product in Model.Products)
                                {
                                    if (counter > 9)
                                        break;

                                    string checkedClass = "";
                                    if (updateCategoryViewModel.ProductIds is not null && updateCategoryViewModel.ProductIds.Any(productId => productId == product.Id))
                                    {
                                        checkedClass = "checked";
                                    }
                                    <tr>
                                        <td class="text-nowrap">@product.Code</td>
                                        <td class="text-nowrap">@product.Name</td>
                                        <td class="text-center">
                                            <div class="form-check d-flex justify-content-center align-items-center">
                                                <input class="form-check-input external-table-checkbox" type="checkbox" value="@product.Id" @checkedClass/>
                                            </div>
                                        </td>
                                    </tr>

                                    counter++;
                                }
                            </tbody>
                        </table>
                        <input asp-for="@updateCategoryViewModel.ProductIds" id="UpdateCategoryViewModel_ProductIds-@updateCategoryViewModel.Id" hidden>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ακύρωση</button>
                    <button type="submit" class="btn btn-primary" id="editCategoryButton-@updateCategoryViewModel.Id">Συνέχεια</button>
                </div>
                <input asp-for="@updateCategoryViewModel.Id" id="updateCategoryViewModel_Id-@updateCategoryViewModel.Id" hidden />
            </form>
        </div>
    </div>
}

<div class="modal fade custom-center-modal modal-result" data-bs-backdrop="static" id="resultModal" data-testid="resultModal" data-popUpValue="" tabindex="-1">
    <div class="modal-dialog modal-confirm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <div class="icon-box">
                    <i class="fas fa-check"></i>
                </div>
                <h4 class="modal-title w-100" id="myModalLabel"></h4>
            </div>
            <div class="modal-body">
                <p class="text-center"></p>
            </div>
            <div class="modal-footer d-flex justify-content-center">
                <button class="btn btn-primary w-75" data-bs-dismiss="modal" data-testid="resultModalCloseButton">Εντάξει</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/customValidation.js"></script>
    <script type="text/javascript" src="~/js/customModals.js"></script>
    <script type="text/javascript" src="~/js/filtersBehaviour.js"></script>
    <script type="text/javascript" src="~/js/filtersRepeatedNonStaticCode.js"></script>
    <script type="text/javascript" src="~/js/externalTableSearchFunctionality.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/slim-select@1.27.1/dist/slimselect.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.3/js/dataTables.js"></script>

    <script>
        function returnTrRow(itemX, isCheckedX){
            return [
                itemX.code,
                itemX.name,
                `<div class="form-check d-flex justify-content-center align-items-center">
                    <input class="form-check-input external-table-checkbox" type="checkbox" value="${itemX.id}" ${isCheckedX} />
                </div>`
            ];
        }

        let products = JSON.parse('@Html.Raw(Json.Serialize(Model.Products))');

        let productsX = products.map((product, index) => {
            let deepProduct = JSON.parse(JSON.stringify(product));

            return {
                ...deepProduct,
                originalIndex: index,
                isFilteredBySearch: false,
                checked: false
            };
        });

        let tableAndHandlersX = setUpExternalTable(productsX, "createCategoryTable", "searchInputCreateCategory", "searchButtonIconIndicatorContainerCreateCategory", "searchButtonIconIndicatorCreateCategory", "CreateCategoryViewModel_ProductIds");

        let createCategoryModal = document.getElementById("createCategoryModal");
        let createCategoryForm = document.getElementById("createCategoryForm");
        createCategoryModal.addEventListener('hidden.bs.modal', () => {
            createCategoryForm.reset();
            const errorSpans = createCategoryForm.querySelectorAll("span.text-danger");
            errorSpans.forEach(span => {
                span.textContent = "";
            });
            resetExternaltable("createCategoryTable", tableAndHandlersX.table, productsX, tableAndHandlersX.handlers);
        });

        let categories = JSON.parse('@Html.Raw(Json.Serialize(Model.Categories))');
        categories = categories.map((category, index) => ({
            ...category,
            originalIndex: index,
            isFilteredBySearch: false,
        }));

        categories.forEach(category => {
            let productsXForThisCategory = products.map((product, index) => {
                let deepProduct = JSON.parse(JSON.stringify(product));

                return {
                    ...deepProduct,
                    originalIndex: index,
                    isFilteredBySearch: false,
                    checked: false,
                    initiallyChecked: false
                };
            });

            let checkedItemsX = [];
            productsXForThisCategory.forEach(productX => {
                if (category.products.some(product => product.id === productX.id)) {
                    productX.checked = true;
                    productX.initiallyChecked = true;
                    checkedItemsX.push(productX.id);
                }
            });

            document.getElementById("UpdateCategoryViewModel_ProductIds-" + category.id).value = checkedItemsX.join(',');

            let tableAndHandlersXForThisCategory = setUpExternalTable(productsXForThisCategory, "updateCategoryTable-" + category.id, "searchInputUpdateCategory-" + category.id,
                "searchButtonIconIndicatorContainerUpdateCategory-" + category.id, "searchButtonIconIndicatorUpdateCategory-" + category.id, "UpdateCategoryViewModel_ProductIds-" + category.id);

            let editCategoryModal = document.getElementById("editCategoryModal-" + category.id);
            let editCategoryForm = document.getElementById("editCategoryForm-" + category.id);
            editCategoryModal.addEventListener('hidden.bs.modal', () => {
                editCategoryForm.reset();
                document.getElementById("updateCategoryViewModel_Name-" + category.id).value = category.name;
                document.getElementById("UpdateCategoryViewModel_ProductIds-" + category.id).value = checkedItemsX.join(',');
                const errorSpans = editCategoryForm.querySelectorAll("span.text-danger");
                errorSpans.forEach(span => {
                    span.textContent = "";
                });
                resetExternaltable("updateCategoryTable-" + category.id, tableAndHandlersXForThisCategory.table, productsXForThisCategory, tableAndHandlersXForThisCategory.handlers);
            });
        });

        let tbody = document.getElementById('categoriesTable').querySelector('tbody');

        /* pagination change */
        document.addEventListener('pagination:pageChange', function (event) {
            renderTable(categories);
        });

        /* items per page change */
        document.addEventListener('itemsPerPage:changed', function (event) {
            renderTable(categories);
        });

        function countHowManyEntriesAreLeftUnfilteredAndUpdatePagination() {
            let count = 0;
            categories.forEach(category => {
                if (!category.isFilteredBySearch) {
                    count++;
                }
            });

            updateTotalItems(count);
        }

        function addTrToTableBody(category){
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="text-nowrap">${category.id}</td>
                <td class="text-nowrap">${category.name}</td>
                <td class="text-nowrap">${category.products.length}</td>
                
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-primary me-2" data-bs-toggle="modal" data-bs-target="#editCategoryModal-${category.id}"><i class="fa-solid fa-pen"></i></a>
                    <a class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#deleteCategoryConfirmationModal-${category.id}"><i class="fa-solid fa-trash"></i></a>
                </td>
            `;
            tbody.appendChild(tr);
        }

        setUpSortingDropdownListeners(categories);
        setUpSearchInputMode(categories, countHowManyEntriesAreLeftUnfilteredAndUpdatePagination);
        setUpSearchInput(categories, countHowManyEntriesAreLeftUnfilteredAndUpdatePagination);
        /* ------------------------------------- */
        document.querySelectorAll('.custom-accordion-button').forEach(button => {
            button.addEventListener('click', function () {
                const content = this.nextElementSibling;
                const isExpanded = content.classList.contains('expanded');

                this.setAttribute('aria-expanded', !isExpanded);
                this.classList.toggle('collapsed', !isExpanded);
                content.classList.toggle('expanded', !isExpanded);
            });
        });

        let createCategoryButton = document.getElementById('createCategoryPromptButton');
        let mainPageTitle = document.getElementById("mainPageTitle");
        function updateCreateCategoryButtonText() {
            if(window.innerWidth < 768){
                mainPageTitle.textContent = "Κατηγορίες";
            }
            else{
                mainPageTitle.textContent = "Κατηγορίες Εφαρμογής";
            }

            if (window.innerWidth < 576) {
                createCategoryButton.innerHTML = '<i class="fa-solid fa-plus"></i>';
            }
            else if (window.innerWidth < 1700) {
                createCategoryButton.innerHTML = 'Δημιουργία';
                createCategoryButton.classList.remove('py-1', 'px-2');
            }
            else {
                createCategoryButton.innerHTML = 'Δημιουργία Κατηγορίας';
                createCategoryButton.classList.remove('py-1', 'px-2');
            }

            createCategoryButton.classList.remove('d-none');
            mainPageTitle.classList.remove('d-none');
        }

        window.addEventListener("load", updateCreateCategoryButtonText);
        window.addEventListener("resize", updateCreateCategoryButtonText);

        function updateObjectsContainer() {
            if (window.innerWidth < 1650) {
                objectsSection.classList.remove('col-xl-9');
                objectsSection.classList.add('col-xl-8');
            }
            else if (window.innerWidth < 2350) {
                objectsSection.classList.add('col-xl-9');
                objectsSection.classList.remove('col-xl-8');
            }
            //for very big screens
            else {
                objectsSection.classList.add('col-xl-9');
                objectsSection.classList.remove('col-xl-8');
            }
        }

        window.addEventListener("load", updateObjectsContainer);
        window.addEventListener("resize", updateObjectsContainer);

        setUpDeleteModalsCustomValidationAndSubmissionProcedures('deleteCategoryConfirmationModal', 'deleteCategoryForm', 'modalDeleteCategoryInput', 'data-category-name', "The provided value does not match the name of the category");

        setUpValidationListeners();
        setUpFormSubmissionValidationListener("createCategoryForm");
        document.querySelectorAll('[id^="editCategoryForm-"]').forEach(form => {
            setUpFormSubmissionValidationListener(form.id);
        });

        /* Server Validation Handling */

        const categoryDeletionSuccess = '@TempData["CategoryDeletionSuccess"]' === 'True';
        const categoryCreationSuccess = '@TempData["CategoryCreationSuccess"]' === 'True';
        const categoryUpdateSuccess = '@TempData["CategoryUpdateSuccess"]' === 'True';
        const categoryNotFoundWithGivenId = '@TempData["CategoryNotFoundWithGivenId"]' === 'True';
        const duplicateEntityName = '@TempData["DuplicateEntityName"]' === 'True';
        const errorFromCreateCategory = '@TempData["ErrorFromCreateCategory"]' === 'True';
        const unknownError = '@TempData["UnknownError"]' === 'True';

        let resultModal = document.getElementById("resultModal");

        if (categoryDeletionSuccess) {
            resultModal.setAttribute("popUpValue", "categoryDeletionSuccess");
            showPopUpModal("resultModal", "Επιτυχία Διαγραφής Κατηγορίας", "Η κατηγόρια διαγράφτηκε επιτυχώς!", "Επιτυχία",
                "Η κατηγορία διαγράφτηκε επιτυχώς!", "success");
        }
        else if(categoryCreationSuccess){
            resultModal.setAttribute("popUpValue", "categoryCreationSuccess");
            showPopUpModal("resultModal", "Επιτυχία Δημιουργίας Κατηγορίας", "Η κατηγορία δημιουργήθηκε επιτυχώς, μπορείτε να την διαχειριστείτε χρησιμοποιώντας αυτό το menu!", "Επιτυχία",
                "Η κατηγορία δημιουργήθηκε επιτυχώς, μπορείτε να την διαχειριστείτε χρησιμοποιώντας αυτό το menu!", "success");
        }
        else if(categoryUpdateSuccess){
            resultModal.setAttribute("popUpValue", "categoryUpdateSuccess");
            showPopUpModal("resultModal", "Επιτυχία Επεξεργασίας Κατηγορίας", "Η κατηγορία ανανεώθηκε επιτυχώς!", "Επιτυχία",
                "Η κατηγορία ανανεώθηκε επιτυχώς!", "success");
        }
        else if(duplicateEntityName && errorFromCreateCategory){
            resultModal.setAttribute("popUpValue", "duplicateEntityName");
            showPopUpModal('resultModal', "Αποτυχία Δημιουργίας Κατηγορίας", "Ο τίτλος κατηγορίας που εισήγατε κατά την δημιουργία της κατηγορίας υπάρχει ήδη στο σύστημα." +
                "Παρακαλώ δοκιμάστε ξανά με διαφορετικό τίτλο κατηγορίας. " +
                "Σε περίπτωση που αντιμετωπίζετε πρόβλημα παρακαλώ επικοινωνήστε μαζί μας μέσω του email υποστήριξης μας kinnaskonstantinos0@gmail.com.",
                "Αποτυχία", "Ο τίτλος κατηγορίας που εισήγατε κατά την δημιουργία της κατηγορίας υπάρχει ήδη στο σύστημα. Παρακαλώ δοκιμάστε ξανά με διαφορετικό τίτλο κατηγορίας.");
        }
        else if(duplicateEntityName){
            resultModal.setAttribute("popUpValue", "duplicateEntityName");
            showPopUpModal('resultModal', "Αποτυχία Ενημέρωσης Κατηγορίας", "Ο τίτλος κατηγορίας που εισήγατε για την ενημέρωση της κατηγορίας υπάρχει ήδη στο σύστημα. " +
                "Παρακαλώ δοκιμάστε ξανά με διαφορετικό τίτλο κατηγορίας. " +
                "Σε περίπτωση που αντιμετωπίζετε πρόβλημα παρακαλώ επικοινωνήστε μαζί μας μέσω του email υποστήριξης μας kinnaskonstantinos0@gmail.com.",
                "Αποτυχία", "Ο τίτλος κατηγορίας που εισήγατε για την ενημέρωση της κατηγορίας υπάρχει ήδη στο σύστημα. Παρακαλώ δοκιμάστε ξανά με διαφορετικό τίτλο κατηγορίας.");
        }
        else if (categoryNotFoundWithGivenId) {
            resultModal.setAttribute("popUpValue", "categoryNotFoundWithGivenId");
            showPopUpModal('resultModal', "Αποτυχία Εύρεσης Κατηγορίας", "Η κατηγορία που προσπαθίσατε να τροποποιήσετε δεν βρέθηκε στο σύστημα. Παρακαλώ ανανεώστε την σελίδα σας και δοκιμάστε ξανά.",
                "Αποτυχία", "Η κατηγορία που προσπαθίσατε να τροποποιήσετε δεν βρέθηκε στο σύστημα. Παρακαλώ ανανεώστε την σελίδα σας και δοκιμάστε ξανά.");
        }
        else if (unknownError) {
            resultModal.setAttribute("popUpValue", "unknownError");
            showPopUpModal('resultModal', "Απρόβλεπτο Πρόβλημα", "Κάποιο πρόβλημα συνέβη από την μεριά του συστήματος. Παρακαλώ δοκιμάστε αργότερα.",
                "Αποτυχία", "Απρόβλεπρο πρόβλημα. Παρακαλώ δοκιμάστε αργότερα.");
        }

    </script>
}
